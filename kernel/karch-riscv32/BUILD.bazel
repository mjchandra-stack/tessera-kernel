#
# Builds only for the bare-metal RISC-V 32 platform; host builds skip it.
# Normative: docs/hardware/01-platform-and-cpu-support.md

load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "karch-riscv32",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "tessera_karch_riscv32",
    edition = "2024",
    target_compatible_with = [
        "@platforms//os:none",
        "@platforms//cpu:riscv32",
    ],
    visibility = ["//kernel:__subpackages__"],
    deps = [
        "//kernel/karch",
        "//kernel/karch-riscv-common",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
