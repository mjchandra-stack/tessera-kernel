#
# The bootable AArch64 kernel ELF. `:kernel-aarch64` always builds for the
# bare-metal AArch64 platform via the kernel platform transition, from any
# invocation platform. QEMU's `-kernel` loads this ELF directly — there is no
# bootloader and no image target on this architecture.
# Normative: docs/kernel/01-kernel-model.md

load("//build/rules:kernel.bzl", "tessera_kernel_binary")

tessera_kernel_binary(
    name = "kernel-aarch64",
    srcs = glob(["src/**/*.rs"]),
    arch = "aarch64",
    # QEMU selects the arm64 Linux boot protocol — the one that builds and
    # passes a device tree — from the Image header at offset 0 of a *flat*
    # binary. Handed an ELF it starts the CPU with every register zero and no
    # device tree at all, so `:kernel-aarch64_image` is what actually boots;
    # `:kernel-aarch64` remains the ELF, for symbols and debugging.
    flat_image = True,
    linker_script = "linker.ld",
    # The image is mapped with a 4 KiB granule, so segments must be padded to
    # 4 KiB rather than lld's AArch64 default of 64 KiB — otherwise one
    # PT_LOAD's tail shares a page with the next one's head and W^X cannot be
    # honoured per page.
    rustc_flags = [
        "-Clink-arg=-z",
        "-Clink-arg=max-page-size=4096",
        # Only the Bazel build embeds the ring-3 device-host and blk-client
        # ELFs (D80/D83); the cargo inner loop builds without them and the
        # check reports them absent.
        "--cfg=has_ring3_host",
        "--check-cfg=cfg(has_ring3_host)",
        # Likewise the verified image store (D146): only Bazel assembles the
        # container, and the check reports it absent when it is not there.
        # NVMe: the ring-3 driver serving the block class over a second
        # transport, with a vector per queue.
        "--cfg=has_nvme",
        "--check-cfg=cfg(has_nvme)",
        "--cfg=has_system_store",
        "--check-cfg=cfg(has_system_store)",
    ],
    version = "0.0.1",  # keep in lockstep with Cargo.toml
    visibility = ["//visibility:public"],
    deps = [
        "//api/firmware",
        "//kernel/arch-conformance",
        "//kernel/devicetree",
        "//kernel/karch",
        "//kernel/karch-aarch64",
        "//kernel/kcore",
        "//kernel/nvme",
        "//kernel/pci",
        "//api/certification:certification",
        "//api/hash",
        "//api/isl:certification_bindings",
        "//api/isl-runtime:isl_runtime",
        "//api/trace-schema:trace_schema",
        "//api/policy-compliance:policy_compliance",
        "//api/isl-fuzz:fuzz_evidence",
        "//kernel/pl061",
        "//kernel/sdhci",
        "//kernel/smmu",
        "//kernel/virtio",
        "//userspace/blk-client:blk_client_image",
        "//userspace/device-host:device_host_image",
        "//userspace/net-client:net_client_image",
        "//userspace/net-driver:net_driver_image",
        "//userspace/nvme-driver:nvme_driver_image",
        "//userspace/pci-bus:pci_bus_image",
        "//userspace/sd-host:sd_host_image",
        "//userspace/gpio-driver:gpio_driver_image",
        "//userspace/platform-bus:platform_bus_image",
        "//userspace/snd-driver:snd_driver_image",
        "//userspace/snd-client:snd_client_image",
        "//userspace/gpu-driver:gpu_driver_image",
        "//userspace/gpu-client:gpu_client_image",
        "//userspace/crypto-driver:crypto_driver_image",
        "//userspace/crypto-client:crypto_client_image",
        "//userspace/certifier:certifier_image",
        "//userspace/gpio-client:gpio_client_image",
        "//userspace/usb-host:usb_host_image",
        "//userspace/usb-storage:usb_storage_image",
        "//userspace/usb-hid:usb_hid_image",
        "//userspace/input-client:input_client_image",
        "//userspace/blk-probe:blk_probe_image",
        "//userspace/device-manager:device_manager_image",
        "//userspace/power-manager:power_manager_image",
        "//store:system_store_image",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
