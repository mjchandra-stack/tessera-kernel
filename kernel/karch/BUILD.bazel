load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "karch",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "tessera_karch",
    edition = "2024",
    visibility = [
        "//kernel:__subpackages__",
        "//tools/lint:__pkg__",
        # The device-tree fuzz harness names MemoryRegion to receive one.
        "//api/isl-fuzz:__pkg__",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "karch_test",
    crate = ":karch",
    edition = "2024",
)
