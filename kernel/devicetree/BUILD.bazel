#
# Architecture-independent: Device Tree is the discovery front end for Arm,
# RISC-V, and development-board platforms alike, so this builds and tests on
# the host like the rest of the neutral crates.
# Normative: docs/hardware/02-hardware-description-and-discovery.md

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "devicetree",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "tessera_devicetree",
    edition = "2024",
    visibility = [
        "//kernel:__subpackages__",
        # The ring-3 platform bus controller reads the same blob with the same
        # crate: a device tree is firmware's word wherever it is parsed.
        "//userspace/platform-bus:__pkg__",
        # The fuzz harness, which hands this parser what firmware might.
        "//api/isl-fuzz:__pkg__",
    ],
    deps = ["//kernel/karch"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "devicetree_test",
    crate = ":devicetree",
    edition = "2024",
)
