#
# The bootable kernel ELF. `:kernel` always builds for the bare-metal x86-64
# platform via the kernel platform transition, from any invocation platform.
# Normative: docs/kernel/01-kernel-model.md

load("//build/rules:kernel.bzl", "tessera_kernel_binary")

tessera_kernel_binary(
    name = "kernel",
    srcs = glob(["src/**/*.rs"]),
    linker_script = "linker.ld",
    # These gate the ring-3 ELF programs on their embedded images, which only
    # the Bazel build provides (the cargo inner loop skips them and each check
    # reports that it did).
    #
    # **`has_device_manager` and `has_blk_probe` are deliberately not set yet.**
    # The driver-framework port they feed is complete enough to enumerate a real
    # PCI function, spawn both programs and route their syscalls through the
    # shared dispatcher — and then the manager stalls after its `ChannelRecv`
    # returns, for a reason not yet found. Embedding the images turns that stall
    # into a 120-second boot timeout, so the check would fail the whole tier-3
    # boot rather than report anything useful.
    #
    # Everything else about the port stays built and lint-gated: the images, the
    # linker scripts, `PortConfigSpace`, `spawn_elf_process` and the check
    # itself. With the images absent `device_manager_elf()` answers empty and
    # the check reports that it was skipped, which is the same shape every other
    # port uses for a check whose inputs the build did not provide. Re-enabling
    # is putting these four lines back.
    rustc_flags = [
        # Likewise the verified image store (D146): only Bazel assembles the
        # container, and the check reports it absent when it is not there.
        "--cfg=has_components",
        "--check-cfg=cfg(has_components)",
        "--cfg=has_system_store",
        "--check-cfg=cfg(has_system_store)",
    ],
    version = "0.0.1",  # keep in lockstep with Cargo.toml
    visibility = ["//visibility:public"],
    deps = [
        "//api/isl-runtime:isl_runtime",
        "//kernel/arch-conformance",
        "//kernel/karch",
        "//kernel/karch-x86_64",
        "//kernel/kcore",
        "//kernel/pci",
        "//components:x86_64",
        "//store:system_store_image",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
