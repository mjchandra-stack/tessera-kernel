# Normative: docs/lifecycle/02-build-and-test-infrastructure.md ("Tier 1")

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "karch-mock",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "tessera_karch_mock",
    edition = "2024",
    visibility = [
        "//kernel:__subpackages__",
        "//tools/lint:__pkg__",
    ],
    deps = ["//kernel/karch"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)

rust_test(
    name = "karch_mock_test",
    crate = ":karch-mock",
    edition = "2024",
)
