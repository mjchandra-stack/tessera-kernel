#
# The bootable RISC-V 64 kernel ELF. `:kernel-riscv64` always builds for the
# bare-metal RISC-V platform via the kernel platform transition, from any
# invocation platform. QEMU's `-kernel` loads this ELF and its default
# firmware (OpenSBI) enters it in S-mode — so unlike AArch64 there is no flat
# image target, because no header at offset 0 selects the boot protocol here.
# Normative: docs/kernel/01-kernel-model.md

load("//build/rules:kernel.bzl", "tessera_kernel_binary")

tessera_kernel_binary(
    name = "kernel-riscv64",
    srcs = glob(["src/**/*.rs"]),
    arch = "riscv64",
    linker_script = "linker.ld",
    version = "0.0.1",  # keep in lockstep with Cargo.toml
    visibility = ["//visibility:public"],
    rustc_flags = [
        # Only the Bazel build embeds the ring-3 block driver's ELF; the cargo
        # inner loop builds the kernel without it and the check reports it
        # absent, exactly as the AArch64 port does for its host programs.
        # Likewise the verified image store (D146): only Bazel assembles the
        # container, and the check reports it absent when it is not there.
        "--cfg=has_components",
        "--check-cfg=cfg(has_components)",
        "--cfg=has_system_store",
        "--check-cfg=cfg(has_system_store)",
    ],
    deps = [
        "//kernel/arch-conformance",
        "//kernel/boot-checks",
        "//kernel/devicetree",
        "//kernel/karch",
        "//kernel/karch-riscv64",
        "//kernel/kcore",
        "//kernel/pci",
        "//kernel/virtio",
        "//components:riscv64",
        "//store:system_store_image",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
