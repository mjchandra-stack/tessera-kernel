#
# The bootable RISC-V 64 kernel ELF. `:kernel-riscv64` always builds for the
# bare-metal RISC-V platform via the kernel platform transition, from any
# invocation platform. QEMU's `-kernel` loads this ELF and its default
# firmware (OpenSBI) enters it in S-mode — so unlike AArch64 there is no flat
# image target, because no header at offset 0 selects the boot protocol here.
# Normative: docs/kernel/01-kernel-model.md

load("//build/rules:kernel.bzl", "tessera_kernel_binary")

tessera_kernel_binary(
    name = "kernel-riscv64",
    srcs = glob(["src/**/*.rs"]),
    arch = "riscv64",
    linker_script = "linker.ld",
    version = "0.0.1",  # keep in lockstep with Cargo.toml
    visibility = ["//visibility:public"],
    deps = [
        "//kernel/arch-conformance",
        "//kernel/devicetree",
        "//kernel/karch",
        "//kernel/karch-riscv64",
        "//kernel/kcore",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
