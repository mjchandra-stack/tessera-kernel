#
# Builds for both the kernel platform (linked into the kernel) and the host
# (tier-1 unit tests against the mock architecture layer).
# Normative: docs/kernel/01-kernel-model.md

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# `isl_bazel` selects the Bazel-generated ISL bindings crate (`process_abi`)
# over the cargo build.rs `OUT_DIR` include (kcore/src/lib.rs, `mod isl_binding`).
_ISL_DEPS = [
    "//api/isl-runtime:isl_runtime",
    "//api/isl:process_abi_bindings",
    "//api/isl:handle_abi_bindings",
    "//api/isl:channel_msg_bindings",
    "//api/isl:device_abi_bindings",
    "//api/isl:memory_abi_bindings",
    "//api/isl:port_event_bindings",
    "//api/isl:kernel_event_bindings",
    "//api/isl:driver_lifecycle_bindings",
    "//api/isl:demo_verdict_bindings",
    "//api/isl:firmware_bindings",
]

_ISL_FLAGS = ["--cfg=isl_bazel"]

# `kconfig_bazel` selects `//config:values` over the cargo build.rs `OUT_DIR`
# include (kcore/src/lib.rs, `pub mod config`). Both run //tools/kconfig over
# config/kernel.config, so the two paths cannot size the kernel differently.
_CONFIG_DEPS = ["//config:values"]

_CONFIG_FLAGS = ["--cfg=kconfig_bazel"]

rust_library(
    name = "kcore",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "tessera_kcore",
    edition = "2024",
    rustc_flags = _ISL_FLAGS + _CONFIG_FLAGS,
    visibility = [
        "//kernel:__subpackages__",
        # The anchor gate reads both halves of the agreement it checks: the
        # container this build produced, and the measurement this kernel is
        # compiled to trust (`kcore::store::TRUSTED_ANCHORS`).
        "//store:__pkg__",
        # The generated components crate reads the same set: it mounts the
        # machine's program store against what this kernel trusts, rather than
        # against an anchor of its own (D290).
        "//components:__pkg__",
        # And the 32-bit user-toolchain gate, for the same reason: it reads
        # both halves of an agreement neither package can hold alone — the ELF
        # a real linker produced, and the loader that has to accept it.
        "//tools/checks:__pkg__",
        "//tools/lint:__pkg__",
    ],
    deps = [
        "//api/firmware",
        "//api/image-store:image_store",
        "//kernel/karch",
    ] + _ISL_DEPS + _CONFIG_DEPS,
)

# Serial by necessity, not by preference. `kcore::trace` holds the ambient
# "what is running now" context in process-global atomics because the kernel
# is single-core (build/README.md, D8) and that context is per-CPU state. A
# multi-threaded test harness is effectively several CPUs sharing one set of
# them: one test's `set_thread_correlation` can land between another's publish
# and its `send`, and the send then stamps a foreign cause. Observed as an
# intermittent failure of
# `exec::tests::an_uncorrelated_message_does_not_erase_the_receivers_cause`.
# When per-CPU trace state lands with SMP, this can go.
rust_test(
    name = "kcore_test",
    crate = ":kcore",
    edition = "2024",
    # **A test thread big enough for the machine's tables.** An `Executive` is
    # built by value here, and the channel table inside it is
    # `MAX_CHANNELS * 2 * QUEUE_CAP` messages of `MAX_INLINE_BYTES` each —
    # about 600 KB once D324 took the queue depth from eight to sixteen, which
    # is past what a libtest thread gets by default. It arrives as
    # `has overflowed its stack` in whichever test happens to build the largest
    # one, which says nothing about the change that caused it.
    env = {
        "RUST_TEST_THREADS": "1",
        "RUST_MIN_STACK": "16777216",
    },
    rustc_flags = _ISL_FLAGS + _CONFIG_FLAGS,
    deps = [
        "//api/firmware",
        "//api/hash",
        "//api/image-store:image_store",
        "//kernel/karch-mock",
        # Test-only, and only ever test-only: this crate verifies a signed
        # program store and must never be able to sign one. Reaching the
        # positive path at all needs something that can (D289, D290).
        "//tools/ed25519-signer:ed25519_signer",
    ] + _ISL_DEPS + _CONFIG_DEPS,
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
