#
# The bootable kernel ELF. `:kernel-x86_64` always builds for the bare-metal
# x86-64 platform via the kernel platform transition, from any invocation
# platform.
#
# **Named for its architecture like its four siblings, since D321.** It was
# `kernel` for as long as x86-64 was the only port and for a while after — the
# arch layer below it gained the suffix when there was a second machine
# (`karch-x86_64`) and this never did, so the tree read as though one port were
# the general case. It is not.
# Normative: docs/kernel/01-kernel-model.md

load("//build/rules:kernel.bzl", "tessera_kernel_binary")

tessera_kernel_binary(
    name = "kernel-x86_64",
    srcs = glob(["src/**/*.rs"]),
    linker_script = "linker.ld",
    # These gate the ring-3 ELF programs on their embedded images, which only
    # the Bazel build provides (the cargo inner loop skips them and each check
    # reports that it did).
    #
    # **One flag, where there used to be a note about two more.** This carried a
    # paragraph explaining that `has_device_manager` and `has_blk_probe` were
    # deliberately unset because the manager stalled after its `ChannelRecv`
    # returned. That stall was found and fixed, the two programs have been in
    # this image since D145, and per-program flags stopped existing when
    # composition moved to `//components` and `config/kernel.config` — a program
    # is in an image or it is not, and the accessor answers empty when it is
    # not. The note outlived all three facts, which is what a comment that
    # describes a workaround rather than a mechanism does (D322).
    rustc_flags = [
        # Likewise the verified image store (D146): only Bazel assembles the
        # container, and the check reports it absent when it is not there.
        "--cfg=has_components",
        "--check-cfg=cfg(has_components)",
        "--cfg=has_system_store",
        "--check-cfg=cfg(has_system_store)",
    ],
    version = "0.0.1",  # keep in lockstep with Cargo.toml
    visibility = ["//visibility:public"],
    deps = [
        "//api/firmware",
        "//api/isl-runtime:isl_runtime",
        "//api/isl:process_abi_bindings",
        "//kernel/arch-conformance",
        "//kernel/karch",
        "//kernel/karch-x86_64",
        "//kernel/kcore",
        "//kernel/vtd",
        "//drivers/pci",
        "//drivers/virtio:virtio",
        "//components:x86_64",
        "//store:system_store_image",
    ],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
