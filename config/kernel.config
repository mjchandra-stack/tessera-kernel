# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Jagadeesh Chandra Muddana <mjchandra@gmail.com>
#
# What a build of Tessera can be told to be: every setting, with the reasoning
# that fixed it and the bound outside which it is not a choice.
#
# Three things vary between two builds of this tree, and each arrived here the
# same way — as a value that was correct where it sat and invisible from
# anywhere else:
#
#   type = size       a fixed-capacity table `kcore` allocates. These were 27
#                     `pub const` declarations across 16 modules (D195).
#   type = feature    a mechanism compiled in or out. These were `--cfg=`
#                     string literals in five kernel BUILD files, declared
#                     nowhere and excluded from the flag gate by name.
#   type = component  a ring-3 program an image carries. These were a Starlark
#                     dict per machine — which is to say, the driver-selection
#                     surface, as a build-file edit.
#
# A *profile* (config/profiles/) is a statement about all three at once, and is
# what "which kernel is this" finally has as an answer.
#
# Not ISL. `docs/api/03` is the schema language for *wire* boundaries, and it
# has no construct for a defaulted, ranged scalar; adding one would change a
# language whose job is ABI compatibility for something that never crosses a
# wire. This format is read by `//tools/kconfig` alone.
#
# `range` is a claim about the code, not a preference: below the minimum some
# path cannot function, and above the maximum a table stops fitting the budget
# its module was written to. Widening one means saying why.
#
# `requires` is a claim of the same kind, about two settings rather than one.
# These were prose — "sized to the scheduler's thread table", "an object larger
# than that could not be reclaimed" — true sentences in comments, which a
# profile could break with nothing to notice. `A >= B` and `A -> B` are those
# sentences written where the tool can check them.
#
# Nothing here is clamped. A profile that asks for something outside a range,
# or that breaks a requirement, does not build — because a kernel silently
# sized differently from the one that was asked for is one nothing downstream
# can tell apart from the one that was.
#
# Normative: docs/kernel/01-kernel-model.md,
# docs/lifecycle/02-build-and-test-infrastructure.md

# --- kcore::devmgr ---

[MAX_DEPENDENTS]
type = size
module = devmgr
default = 4
range = 1..=32
doc = Services that may depend on one device.
doc =
doc = Small, and bounded like every kcore pool. A device with more dependents
doc = than this refuses the registration rather than forgetting one — a dependent
doc = that believes it is registered and is not would wait for ever on a
doc = notification nobody is going to send.

[MAX_DEVICES]
type = size
module = devmgr
default = 8
range = 1..=64
doc = Device nodes the resource graph holds.

[MAX_EXTRA_IRQS]
type = size
module = devmgr
default = 3
range = 0..=15
doc = Interrupt lines a device may have beyond its first.
doc =
doc = Three, so a controller may raise one per queue for a handful of queues
doc = without the graph growing a list. A device with more than this is refused a
doc = line rather than quietly given fewer: a queue whose completions reach
doc = nobody is one whose driver waits forever, and that is worse to debug than a
doc = registration that said no.

# --- kcore::dispatch ---

[MAX_RECV_ANY]
type = size
module = dispatch
default = 8
range = 1..=64
doc = Endpoints one `ChannelRecvAny` may wait on. Bounded like every vector that
doc = crosses this boundary; a server with more clients than this is one whose
doc = fan-out belongs to a router rather than to a syscall.

# --- kcore::elf ---

[MAX_SEGMENTS]
type = size
module = elf
default = 8
range = 1..=32
doc = Loadable segments a single image may carry this milestone (bounded, like
doc = every kcore pool).

# --- kcore::event ---

[EVENT_RING_CAPACITY]
type = size
module = event
default = 256
range = 16..=4096
doc = Events the ring holds before it must drop (bounded like every kcore pool —
doc = no general allocator, D15/D29).
doc =
doc = Sized for a whole boot's emission without an intervening harvest, because
doc = nothing harvests yet (the log service is Stage 1). Fan-out link events made
doc = that concrete: the restart-supervision demos spawn dozens of threads, and at
doc = 64 the ring filled with links and — since a full ring drops the *newest* —
doc = silently discarded the fault reports that came after them (D59).

# --- kcore::handle ---

[MAX_HANDLES]
type = size
module = handle
default = 1024
range = 16..=16384
doc = Maximum handles per process this milestone.

# --- kcore::ipc ---

[MAX_CHANNELS]
type = size
module = ipc
default = 64
range = 4..=1024
doc = Channels the table holds.

[MAX_INLINE_BYTES]
type = size
module = ipc
default = 256
range = 64..=4096
doc = Maximum inline payload bytes (matches the B3 ≤ 256 B call size).

[MAX_MSG_HANDLES]
type = size
module = ipc
default = 4
range = 1..=16
doc = Maximum handles transferred per message (matches the B4 ≤ 4 handles case).

# --- kcore::job ---

[MAX_CHILDREN_PER_JOB]
type = size
module = job
default = 8
range = 1..=64
doc = Child jobs a single job may hold.

[MAX_JOBS]
type = size
module = job
default = 16
range = 1..=256
doc = Jobs the table holds.

[MAX_MEMBERS_PER_JOB]
type = size
module = job
default = 8
range = 1..=64
doc = Member processes a single job may hold.

# --- kcore::memory ---

[MAX_MEMORY_OBJECTS]
type = size
module = memory
default = 8
range = 1..=64
doc = Memory objects the table holds — bounded like every kcore pool (D15).

[MAX_OBJECT_PAGES]
type = size
module = memory
default = 16
range = 1..=1024
requires = MAX_OBJECT_PAGES <= MAX_FREE_FRAMES
doc = Pages one object may hold: 64 KiB.
doc =
doc = The same ceiling `MapDevice` puts on a register window, and chosen against
doc = a harder bound: [`crate::pmem::MAX_FREE_FRAMES`] is 256, so an object
doc = larger than that could not be reclaimed without overflowing the free list
doc = and leaking the excess — one `MEM_RECLAIM_OVERFLOW` record per frame. A
doc = limit that cannot be honoured on the way out is not a limit.

# --- kcore::object ---

[MAX_OBJECTS]
type = size
module = object
default = 256
range = 16..=4096
doc = Maximum live kernel objects this milestone.

# --- kcore::pager ---

[MAX_CACHED_PAGES]
type = size
module = pager
default = 64
range = 8..=4096
doc = Resident pages a single object's cache tracks this milestone (bounded, like
doc = every kcore pool — no general allocator yet, D15/D29).

[MAX_PAGERS]
type = size
module = pager
default = 8
range = 1..=64
doc = Bound on tracked pager bindings / in-flight page-in edges (like every kcore
doc = pool — bounded, no general allocator, D15/D29).

# --- kcore::pmem ---

[MAX_FREE_FRAMES]
type = size
module = pmem
default = 256
range = 16..=4096
doc = Freed frames the reuse free-list can hold before a reclaim overflows and
doc = the frame leaks (counted). Bounded — no general allocator yet (D29).
doc =
doc = Private to its module until now, which is why the sizing migration walked
doc = past it: the gate that finds a capacity back in a module looks for a
doc = `pub const`. It is declared here because something else depends on it —
doc = `MAX_OBJECT_PAGES` may not exceed it, or an object could be created and
doc = not reclaimed, one `MEM_RECLAIM_OVERFLOW` per frame.

[MAX_SHARED_FRAMES]
type = size
module = pmem
default = 256
range = 16..=4096
doc = Distinct frames the shared-reference table tracks (those with more than
doc = one reference — copy-on-write sharers). A frame absent from the table has
doc = an implicit single reference. Bounded (D29).

# --- kcore::port ---

[MAX_BINDINGS]
type = size
module = port
default = 8
range = 1..=64
doc = Bindings (one per `(source, signal)` pair) a single port holds.

[MAX_PORTS]
type = size
module = port
default = 32
range = 4..=256
doc = Ports the table holds.

# --- kcore::power ---

[MAX_WAKE_HOLDS]
type = size
module = power
default = 8
range = 1..=64
doc = Wake holds the kernel tracks at once.
doc =
doc = Bounded like every pool here, and small deliberately: a full table is a
doc = reportable condition, and a suspend blocker that could be taken without
doc = limit is a machine that never sleeps for a reason nobody can enumerate.

# --- kcore::process ---

[MAX_DEVICE_WINDOWS]
type = size
module = process
default = 8
range = 1..=64
doc = Device register windows one process may hold open at once. A driver maps
doc = its own device and little else; a device *manager* maps every device it
doc = enumerates, which is what sizes this.

[MAX_MEMORY_MAPPINGS]
type = size
module = process
default = 8
range = 1..=64
doc = Memory grants one process may hold mapped at once.
doc =
doc = Larger than the device-window bound, because a driver maps one device and
doc = may hold a buffer per outstanding request.

[MAX_PROCESSES]
type = size
module = process
default = 16
range = 2..=256
doc = Processes the table holds.

[MAX_THREADS_PER_PROCESS]
type = size
module = process
default = 8
range = 1..=64
doc = Threads a single process may hold this milestone.

# --- kcore::sched ---

[MAX_THREADS]
type = size
module = sched
default = 16
range = 2..=256
doc = Maximum threads a single CPU's scheduler tracks this milestone.

# --- kcore::wait ---

[MAX_WAITERS]
type = size
module = wait
default = 16
range = 1..=256
requires = MAX_WAITERS >= MAX_THREADS
doc = Blocked waiters the set can hold at once. A thread blocks in at most one
doc = place, so this is sized to the scheduler's thread table
doc = (`sched::MAX_THREADS`); kept a local constant to keep this module free of a
doc = scheduler dependency.
doc =
doc = "Sized to the scheduler's thread table" was a sentence, and a profile
doc = could raise `MAX_THREADS` past it with nothing to notice — leaving a
doc = machine with more threads than it has room to block, which shows up as a
doc = refused wait on a path that has no other way to fail. The `requires` above
doc = is that sentence, where the tool can check it.

# ============================== features ==============================
#
# A mechanism compiled in or out. Each names the `cfg` a kernel built with it
# carries; the ports read `#[cfg(has_x)]` / `#[cfg(not(has_x))]`, so a feature
# that is off contributes no flag rather than a negated one.
#
# These were `--cfg=` string literals hand-written into five kernel BUILD
# files, with a comment each saying why — and the codegen-flag gate excluded
# `--cfg=` from its comparison by name, so nothing checked that the five agreed
# with each other or with anything else.

[COMPONENTS]
type = feature
cfg = has_components
machines = aarch64, riscv64, x86_64
default = y
doc = Whether this image carries ring-3 programs at all.
doc =
doc = Named for three machines and not five: `riscv32` and `arm32` reach ring 3
doc = with hand-assembled blobs rather than with compiled programs, so there is
doc = no composition for them to carry and nothing for this to switch. A machine
doc = is listed here when it has one.
doc =
doc = Off is not a broken build: it is what the cargo inner loop has always
doc = been, because cargo builds no ring-3 ELFs. Every check that needs a
doc = program reports it absent and the boot goes on. That is what makes this a
doc = feature rather than a fact about Bazel — a kernel with no user programs is
doc = a machine somebody can ask for.

[SYSTEM_STORE]
type = feature
cfg = has_system_store
default = y
doc = Whether this image carries the verified image store (D146).
doc =
doc = Only Bazel assembles the container (`//store:system_store_image`); the
doc = cargo inner loop builds without it and the store's self-check reports it
doc = absent rather than failing.

# ============================= components =============================
#
# The ring-3 programs an image may carry. The kernel has no filesystem to load
# one from, so every program it starts is compiled into it.
#
# `machines` is not a preference: it is the list of machines that have an image
# for this program, and turning on a component a machine has no image for is
# refused rather than left to fail at link time. The labels themselves stay in
# //components/BUILD.bazel, because Bazel must know them statically to form the
# dependency edges — and `//tools/kconfig` holds the two lists to each other in
# both directions, so a program in one and not the other is a build error
# rather than a program that has quietly stopped being configurable.
#
# A component that is off keeps its accessor and returns an empty slice — the
# absence every check already reports. Nothing then references its image crate,
# so the linker never pulls the program's bytes in: the option really removes
# the program rather than only the mention of it.
#
# `requires` here is the boolean kind, and each one is a statement about what a
# program does at boot: a client with no driver waits for a service nobody
# offers, and every driver on the AArch64 machine is bound to its device by the
# device manager.

[device_manager]
type = component
machines = aarch64, riscv64, x86_64
default = y
doc = Enumerates devices and binds a driver to each by class. Every other
doc = driver and client on this machine depends on it, which is why it is the
doc = one component with no requirement of its own.

[device_host]
type = component
machines = aarch64
default = y
doc = The resident driver host: serves a device class to clients over channel
doc = IPC, and is restarted and re-bound by the device manager when it dies.
requires = device_host -> device_manager

[blk_client]
type = component
machines = aarch64
default = y
doc = Reads sectors through whichever host is serving the block class — the
doc = driver host, the SD host, the NVMe driver or USB storage.
requires = blk_client -> device_manager

[blk_driver]
type = component
machines = riscv64
default = y
doc = The compiled ring-3 virtio-blk driver (D105), and the first
doc = `Machine::RiscV64` ELF the loader takes.
requires = blk_driver -> device_manager

[blk_probe]
type = component
machines = aarch64, riscv64, x86_64
default = y
doc = Reads the disk through the bound block driver — the one program every
doc = machine carries, which is what makes it the check that a machine's whole
doc = binding path works.
requires = blk_probe -> device_manager

[root_task]
type = component
machines = x86_64
default = y
doc = The x86-64 root task: the first ring-3 program, and the one that proves
doc = the loader on that port.

[pci_bus]
type = component
machines = aarch64, x86_64
default = y
doc = Enumerates the PCIe bus from ring 3 and hands what it finds to the device
doc = manager.
requires = pci_bus -> device_manager

[platform_bus]
type = component
machines = aarch64
default = y
doc = Enumerates the platform (device-tree) bus from ring 3, for the devices no
doc = PCIe scan can find.
requires = platform_bus -> device_manager

[power_manager]
type = component
machines = aarch64
default = y
doc = Takes and releases wake holds, and drives the suspend path.
requires = power_manager -> device_manager

[certifier]
type = component
machines = aarch64
default = y
doc = Runs a driver's class-conformance suite from ring 3 and signs the result.
requires = certifier -> device_manager

[crypto_driver]
type = component
machines = aarch64
default = y
doc = Serves the crypto class.
requires = crypto_driver -> device_manager

[crypto_client]
type = component
machines = aarch64
default = y
doc = Asks the crypto driver for a hash.
requires = crypto_client -> crypto_driver

[gpio_driver]
type = component
machines = aarch64
default = y
doc = Serves the GPIO class over the PL061 controller.
requires = gpio_driver -> platform_bus

[gpio_client]
type = component
machines = aarch64
default = y
doc = Drives a GPIO line through the driver, and reads it back.
requires = gpio_client -> gpio_driver

[gpu_driver]
type = component
machines = aarch64
default = y
doc = Serves the GPU class.
requires = gpu_driver -> device_manager

[gpu_client]
type = component
machines = aarch64
default = y
doc = Composes an image and hands it to the GPU driver to scan out.
requires = gpu_client -> gpu_driver

[net_driver]
type = component
machines = aarch64
default = y
doc = Serves the network class over virtio-net.
requires = net_driver -> device_manager

[net_client]
type = component
machines = aarch64
default = y
doc = Completes an ARP round trip through the network driver.
requires = net_client -> net_driver

[snd_driver]
type = component
machines = aarch64
default = y
doc = Serves the sound class.
requires = snd_driver -> device_manager

[snd_client]
type = component
machines = aarch64
default = y
doc = Plays a buffer through the sound driver.
requires = snd_client -> snd_driver

[nvme_driver]
type = component
machines = aarch64
default = y
doc = Serves the block class over NVMe, with a completion vector per queue.
requires = nvme_driver -> device_manager

[sd_host]
type = component
machines = aarch64
default = y
doc = Serves the block class over SDHCI.
requires = sd_host -> device_manager

[usb_host]
type = component
machines = aarch64
default = y
doc = Drives the xHCI controller and enumerates what is attached to it.
requires = usb_host -> device_manager

[usb_storage]
type = component
machines = aarch64
default = y
doc = Serves the block class over USB mass storage, behind the USB host.
requires = usb_storage -> usb_host

[usb_hid]
type = component
machines = aarch64
default = y
doc = Serves the input class over USB HID, behind the USB host.
requires = usb_hid -> usb_host

[input_client]
type = component
machines = aarch64
default = y
doc = Reads input reports through the HID driver.
requires = input_client -> usb_hid
