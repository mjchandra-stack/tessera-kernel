#
# The kernel's configuration surface: one declaration of every setting a build
# of this tree has — the fixed-capacity tables `kcore` allocates, the
# mechanisms compiled in or out, and the ring-3 programs each image carries —
# and the profiles that choose them.
#
# Build another profile with `--//config:profile=<name>`, which reconfigures
# the whole invocation: the constants and the composition together, because
# they are one statement about one machine.
# Normative: docs/kernel/01-kernel-model.md

load("//build/rules:kconfig.bzl", "tessera_kconfig")

exports_files(["kernel.config"])

# The profile flag, the settings that read it, and what every kernel in this
# tree is sized by.
tessera_kconfig(
    name = "values",
    visibility = ["//kernel/kcore:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
