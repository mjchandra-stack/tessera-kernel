#
# A C program that says something a person can read: its own arguments, on the
# kernel's debug console, through the buffer form of `DebugWrite` that this port
# has always implemented and nothing in C could reach (docs/roadmap/04 Phase 4;
# D318).
#
# It is also what asked for `<string.h>`: printing arguments means measuring
# strings whose length nobody gave it and assembling a line out of them, which
# is `strlen` and `memcpy` with a caller each.
# Normative: docs/roadmap/04-self-hosting.md ("Phase 4")

load("//build/rules:cprogram.bzl", "tessera_c_binary")
load("//build/rules:embed.bzl", "tessera_embedded_elf")

tessera_c_binary(
    name = "c_say_probe",
    srcs = ["src/main.c"],
    visibility = ["//components:__pkg__"],
)

tessera_embedded_elf(
    name = "c_say_probe_image",
    binary = ":c_say_probe",
    visibility = ["//components:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
