#
# The first ring-3 program in this tree that allocates. It declares a
# `#[global_allocator]` over //userspace/ualloc's free list, links `alloc`, and
# builds vectors no fixed buffer it could have declared would hold —
# `docs/roadmap/04` Phase 0's claim, made where it can be falsified.
#
# The check that runs it asserts the reuse, not merely the allocation: a bump
# allocator that never reclaimed would satisfy every earlier step.
# Normative: docs/roadmap/04-self-hosting.md ("Phase 0")

load("//build/rules:embed.bzl", "tessera_embedded_elf")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "heap_probe",
    # The program store is built from this binary, so //components reads it
    # directly rather than through an embedded-bytes crate (D290).
    visibility = ["//components:__pkg__"],
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "//build/rules:user-aarch64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/isl-runtime:isl_runtime",
        "//api/isl:memory_abi_bindings",
        "//userspace/uabi:uabi",
        "//userspace/ualloc:ualloc",
    ],
)

tessera_embedded_elf(
    name = "heap_probe_image",
    binary = ":heap_probe",
    visibility = ["//components:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
