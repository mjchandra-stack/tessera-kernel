#
# The ring-3 GPIO client: a no_std Rust user program that asks for one line and
# waits for it. It holds no device and maps nothing — what it has after
# WatchLine is a capability to one line's interrupt, which it may wait on and
# may not raise. Two of them run in the boot check on different lines, and the
# one that does not wake is the load-bearing half.
# Normative: docs/drivers/04-embedded-buses-power-and-timekeeping.md,
# docs/drivers/01-driver-framework.md

load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "gpio_client",
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "gpio-client.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/isl:channel_msg_bindings",
        "//api/isl:gpio_controller_bindings",
        "//api/isl-runtime:isl_runtime",
        "//userspace/uabi:uabi",
    ],
)

# The built ELF as Rust bytes (generated at build time, never checked in —
# docs/lifecycle/04, "never check in generated code").
genrule(
    name = "gpio_client_image_src",
    srcs = [":gpio_client"],
    outs = ["gpio_client_image.rs"],
    cmd = """
{
  echo '// SPDX-License-Identifier: Apache-2.0'
  echo '// Copyright 2026 Jagadeesh Chandra Muddana <mjchandra@gmail.com>'
  echo '// Generated from //userspace/gpio-client:gpio_client — do not edit.'
  echo '#![no_std]'
  printf 'pub static GPIO_CLIENT_ELF: [u8; %s] = [' "$$(wc -c < $(location :gpio_client))"
  od -An -v -tu1 $(location :gpio_client) | tr ' ' '\\n' | grep . | paste -sd, -
  echo '];'
} > $@
""",
)

rust_library(
    name = "gpio_client_image",
    srcs = [":gpio_client_image_src"],
    crate_name = "gpio_client_image",
    edition = "2024",
    visibility = ["//kernel/kernel-aarch64:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
