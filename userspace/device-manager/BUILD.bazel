#
# The ring-3 AArch64 device manager (D91): the program that enumerates the
# machine's devices and grants each driver the one it binds to. Built as an
# ET_EXEC ELF the aarch64 kernel's loader parses and maps, and embedded via
# the same generated-bytes pattern as the device host; only the Bazel build
# embeds it (the cargo inner loop builds the kernel without it and prints a
# skip line).
# Normative: docs/lifecycle/02-build-and-test-infrastructure.md,
# docs/hardware/04-device-memory-and-unified-memory.md

load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "device_manager",
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "device-manager.aarch64.ld",
    # Optimize: keeps the text segment a handful of pages; the program is
    # embedded byte-for-byte into the kernel image.
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/binding:binding",
        "//userspace/uabi:uabi",
        "//api/isl:channel_msg_bindings",
        "//api/isl:device_abi_bindings",
        "//api/isl:driver_bind_bindings",
        "//api/isl:firmware_bindings",
        "//api/isl:driver_lifecycle_bindings",
        "//api/isl:handle_abi_bindings",
        "//api/isl-runtime:isl_runtime",
        "//kernel/pl061",
    ],
)

# The built ELF as Rust bytes (generated at build time, never checked in —
# docs/lifecycle/04, "never check in generated code"). The aarch64 kernel
# links this and feeds the bytes to its ELF loader.
genrule(
    name = "device_manager_image_src",
    srcs = [":device_manager"],
    outs = ["device_manager_image.rs"],
    cmd = """
{
  echo '// SPDX-License-Identifier: Apache-2.0'
  echo '// Copyright 2026 Jagadeesh Chandra Muddana <mjchandra@gmail.com>'
  echo '// Generated from //userspace/device-manager:device_manager — do not edit.'
  echo '#![no_std]'
  printf 'pub static DEVICE_MANAGER_ELF: [u8; %s] = [' "$$(wc -c < $(location :device_manager))"
  od -An -v -tu1 $(location :device_manager) | tr ' ' '\\n' | grep . | paste -sd, -
  echo '];'
} > $@
""",
)

rust_library(
    name = "device_manager_image",
    srcs = [":device_manager_image_src"],
    crate_name = "device_manager_image",
    edition = "2024",
    visibility = ["//kernel/kernel-aarch64:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)

# The same source, built for the second architecture. The framework's claim is
# that it is common; two targets over one source is what makes that checkable
# rather than asserted.
tessera_user_binary(
    name = "device_manager_riscv64",
    srcs = ["src/main.rs"],
    arch = "riscv64",
    linker_script = "device-manager.riscv64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/binding:binding",
        "//userspace/uabi:uabi",
        "//api/isl:channel_msg_bindings",
        "//api/isl:device_abi_bindings",
        "//api/isl:driver_bind_bindings",
        "//api/isl:firmware_bindings",
        "//api/isl:driver_lifecycle_bindings",
        "//api/isl:handle_abi_bindings",
        "//api/isl-runtime:isl_runtime",
        "//kernel/pl061",
    ],
)

genrule(
    name = "device_manager_image_riscv64_src",
    srcs = [":device_manager_riscv64"],
    outs = ["device_manager_image_riscv64.rs"],
    cmd = """
{
  echo '// SPDX-License-Identifier: Apache-2.0'
  echo '// Copyright 2026 Jagadeesh Chandra Muddana <mjchandra@gmail.com>'
  echo '// Generated from //userspace/device-manager:device_manager_riscv64 — do not edit.'
  echo '#![no_std]'
  printf 'pub static DEVICE_MANAGER_ELF: [u8; %s] = [' "$$(wc -c < $(location :device_manager_riscv64))"
  od -An -v -tu1 $(location :device_manager_riscv64) | tr ' ' '\\n' | grep . | paste -sd, -
  echo '];'
} > $@
""",
)

rust_library(
    name = "device_manager_image_riscv64",
    srcs = [":device_manager_image_riscv64_src"],
    crate_name = "device_manager_image_riscv64",
    edition = "2024",
    visibility = ["//kernel/kernel-riscv64:__pkg__"],
)

# And the third architecture. The manager and the probe are the same
# sources on all three; what differs is the linker script's output format
# and load address, which is the whole of what a port costs a user program.
tessera_user_binary(
    name = "device_manager_x86_64",
    srcs = ["src/main.rs"],
    arch = "x86_64",
    linker_script = "device-manager.x86_64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/binding:binding",
        "//userspace/uabi:uabi",
        "//api/isl:channel_msg_bindings",
        "//api/isl:device_abi_bindings",
        "//api/isl:driver_bind_bindings",
        "//api/isl:firmware_bindings",
        "//api/isl:driver_lifecycle_bindings",
        "//api/isl:handle_abi_bindings",
        "//api/isl-runtime:isl_runtime",
        "//kernel/pl061",
    ],
)

genrule(
    name = "device_manager_image_x86_64_src",
    srcs = [":device_manager_x86_64"],
    outs = ["device_manager_image_x86_64.rs"],
    cmd = """
{
  echo '// SPDX-License-Identifier: Apache-2.0'
  echo '// Copyright 2026 Jagadeesh Chandra Muddana <mjchandra@gmail.com>'
  echo '// Generated from //userspace/device-manager:device_manager_x86_64 — do not edit.'
  echo '#![no_std]'
  printf 'pub static DEVICE_MANAGER_ELF: [u8; %s] = [' "$$(wc -c < $(location :device_manager_x86_64))"
  od -An -v -tu1 $(location :device_manager_x86_64) | tr ' ' '\\n' | grep . | paste -sd, -
  echo '];'
} > $@
""",
)

rust_library(
    name = "device_manager_image_x86_64",
    srcs = [":device_manager_image_x86_64_src"],
    crate_name = "device_manager_image_x86_64",
    edition = "2024",
    visibility = ["//kernel/kernel:__pkg__"],
)
