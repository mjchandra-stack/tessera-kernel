#
# A program that reaches the network by asking: it holds one endpoint to a
# stack instance, speaks flow_service.isl and DHCP, and knows nothing between
# them. No device capability, no DMA, no NIC, and no Ethernet constant.
# Normative: docs/network/01-network-stack.md ("Flow API And Port Authority")

load("//build/rules:embed.bzl", "tessera_embedded_elf")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "flow_client",
    # The program store is built from this binary, so //components reads it
    # directly rather than through an embedded-bytes crate (D290).
    visibility = ["//components:__pkg__"],
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "//build/rules:user-aarch64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/isl:flow_service_bindings",
        "//api/isl-runtime:isl_runtime",
        "//api/net:net",
        "//userspace/sdk:sdk",
        "//userspace/uabi:uabi",
    ],
)

# The same source on the second machine: this program holds no device and
# speaks only channels, so what changes is the target and nothing else.
tessera_user_binary(
    name = "flow_client_x86_64",
    # The program store is built from this binary, so //components reads it
    # directly rather than through an embedded-bytes crate (D290).
    visibility = ["//components:__pkg__"],
    srcs = ["src/main.rs"],
    arch = "x86_64",
    linker_script = "//build/rules:user-x86_64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/isl:flow_service_bindings",
        "//api/isl-runtime:isl_runtime",
        "//api/net:net",
        "//userspace/sdk:sdk",
        "//userspace/uabi:uabi",
    ],
)

tessera_embedded_elf(
    name = "flow_client_image",
    binary = ":flow_client",
    visibility = ["//components:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
