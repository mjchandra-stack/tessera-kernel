#
# The ring-3 AArch64 device manager (D91): the program that enumerates the
# machine's devices and grants each driver the one it binds to. Built as an
# ET_EXEC ELF the aarch64 kernel's loader parses and maps, and embedded via
# the same generated-bytes pattern as the device host; only the Bazel build
# embeds it (the cargo inner loop builds the kernel without it and prints a
# skip line).
# Normative: docs/lifecycle/02-build-and-test-infrastructure.md,
# docs/hardware/04-device-memory-and-unified-memory.md

load("//build/rules:embed.bzl", "tessera_embedded_elf")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "blk_probe",
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "//build/rules:user-aarch64.ld",
    # Optimize: keeps the text segment a handful of pages; the program is
    # embedded byte-for-byte into the kernel image.
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//userspace/uabi:uabi",
        "//api/isl:channel_msg_bindings",
        "//api/isl:device_abi_bindings",
        "//api/isl:driver_bind_bindings",
        "//api/isl:driver_lifecycle_bindings",
        "//api/isl:firmware_bindings",
        "//api/isl:memory_abi_bindings",
        "//api/hash",
        "//api/isl-runtime:isl_runtime",
    ],
)

# The built ELF as Rust bytes (generated at build time, never checked in —
# docs/lifecycle/04, "never check in generated code"). The aarch64 kernel
# links this and feeds the bytes to its ELF loader.

tessera_embedded_elf(
    name = "blk_probe_image",
    binary = ":blk_probe",
    visibility = ["//components:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)

# The same source, built for the second architecture. The framework's claim is
# that it is common; two targets over one source is what makes that checkable
# rather than asserted.
tessera_user_binary(
    name = "blk_probe_riscv64",
    srcs = ["src/main.rs"],
    arch = "riscv64",
    linker_script = "//build/rules:user-riscv64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//userspace/uabi:uabi",
        "//api/isl:channel_msg_bindings",
        "//api/isl:device_abi_bindings",
        "//api/isl:driver_bind_bindings",
        "//api/isl:driver_lifecycle_bindings",
        "//api/isl:firmware_bindings",
        "//api/isl:memory_abi_bindings",
        "//api/hash",
        "//api/isl-runtime:isl_runtime",
    ],
)


tessera_embedded_elf(
    name = "blk_probe_image_riscv64",
    binary = ":blk_probe_riscv64",
    symbol = "BLK_PROBE_ELF",
    visibility = ["//components:__pkg__"],
)

# And the third architecture. The manager and the probe are the same
# sources on all three; what differs is the linker script's output format
# and load address, which is the whole of what a port costs a user program.
tessera_user_binary(
    name = "blk_probe_x86_64",
    srcs = ["src/main.rs"],
    arch = "x86_64",
    linker_script = "//build/rules:user-x86_64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//userspace/uabi:uabi",
        "//api/isl:channel_msg_bindings",
        "//api/isl:device_abi_bindings",
        "//api/isl:driver_bind_bindings",
        "//api/isl:driver_lifecycle_bindings",
        "//api/isl:firmware_bindings",
        "//api/isl:memory_abi_bindings",
        "//api/hash",
        "//api/isl-runtime:isl_runtime",
    ],
)


tessera_embedded_elf(
    name = "blk_probe_image_x86_64",
    binary = ":blk_probe_x86_64",
    symbol = "BLK_PROBE_ELF",
    visibility = ["//components:__pkg__"],
)
