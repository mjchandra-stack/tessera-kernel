#
# The ring-3 PCI bus driver: the program that walks the bus so the kernel does
# not have to. It holds the host bridge and a channel to the device manager,
# enumerates with the unchanged tessera_pci crate, declares what it found, and
# offers each function on. Built from one source for both machines that have a
# PCI host bridge; only the linker script differs, which is the whole of what a
# port costs a user program.
# Normative: docs/drivers/01-driver-framework.md ("Bus Topology And Data Paths")

load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

PCI_BUS_DEPS = [
    "//api/isl:channel_msg_bindings",
    "//api/isl:device_abi_bindings",
    "//api/isl-runtime:isl_runtime",
    "//kernel/pci:pci",
    "//userspace/uabi:uabi",
]

tessera_user_binary(
    name = "pci_bus",
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "pci-bus.aarch64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = PCI_BUS_DEPS,
)

genrule(
    name = "pci_bus_image_src",
    srcs = [":pci_bus"],
    outs = ["pci_bus_image.rs"],
    cmd = """
{
  echo '// SPDX-License-Identifier: Apache-2.0'
  echo '// Copyright 2026 Jagadeesh Chandra Muddana <mjchandra@gmail.com>'
  echo '// Generated from //userspace/pci-bus:pci_bus — do not edit.'
  echo '#![no_std]'
  printf 'pub static PCI_BUS_ELF: [u8; %s] = [' "$$(wc -c < $(location :pci_bus))"
  od -An -v -tu1 $(location :pci_bus) | tr ' ' '\\n' | grep . | paste -sd, -
  echo '];'
} > $@
""",
)

rust_library(
    name = "pci_bus_image",
    srcs = [":pci_bus_image_src"],
    crate_name = "pci_bus_image",
    edition = "2024",
    visibility = ["//kernel/kernel-aarch64:__pkg__"],
)

tessera_user_binary(
    name = "pci_bus_x86_64",
    srcs = ["src/main.rs"],
    arch = "x86_64",
    linker_script = "pci-bus.x86_64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = PCI_BUS_DEPS,
)

genrule(
    name = "pci_bus_image_x86_64_src",
    srcs = [":pci_bus_x86_64"],
    outs = ["pci_bus_image_x86_64.rs"],
    cmd = """
{
  echo '// SPDX-License-Identifier: Apache-2.0'
  echo '// Copyright 2026 Jagadeesh Chandra Muddana <mjchandra@gmail.com>'
  echo '// Generated from //userspace/pci-bus:pci_bus_x86_64 — do not edit.'
  echo '#![no_std]'
  printf 'pub static PCI_BUS_ELF: [u8; %s] = [' "$$(wc -c < $(location :pci_bus_x86_64))"
  od -An -v -tu1 $(location :pci_bus_x86_64) | tr ' ' '\\n' | grep . | paste -sd, -
  echo '];'
} > $@
""",
)

rust_library(
    name = "pci_bus_image_x86_64",
    srcs = [":pci_bus_image_x86_64_src"],
    crate_name = "pci_bus_image_x86_64",
    edition = "2024",
    visibility = ["//kernel/kernel:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
