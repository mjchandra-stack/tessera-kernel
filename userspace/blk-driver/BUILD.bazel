#
# The ring-3 RISC-V 64 block driver: a real no_std Rust user program that
# drives virtio-blk through the memory-safe tessera-virtio core unchanged,
# built as an ET_EXEC ELF the riscv64 kernel's loader parses and maps. Embedded
# via the same generated-bytes pattern as the x86 root task and the AArch64
# device host; only the Bazel build embeds it (the cargo inner loop builds the
# kernel without it and prints a skip line).
# Normative: docs/lifecycle/02-build-and-test-infrastructure.md,
# docs/hardware/04-device-memory-and-unified-memory.md

load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "blk_driver",
    srcs = ["src/main.rs"],
    arch = "riscv64",
    linker_script = "blk-driver.ld",
    # Optimize: keeps the text segment a couple of pages, and the driver is
    # embedded byte-for-byte into the kernel image.
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//userspace/uabi:uabi",
        "//api/isl:device_abi_bindings",
        "//api/isl:port_event_bindings",
        "//api/isl-runtime:isl_runtime",
        "//kernel/virtio:virtio",
    ],
)

# The built ELF as Rust bytes (generated at build time, never checked in —
# docs/lifecycle/04, "never check in generated code").
genrule(
    name = "blk_driver_image_src",
    srcs = [":blk_driver"],
    outs = ["blk_driver_image.rs"],
    cmd = """
{
  echo '// SPDX-License-Identifier: Apache-2.0'
  echo '// Copyright 2026 Jagadeesh Chandra Muddana <mjchandra@gmail.com>'
  echo '// Generated from //userspace/blk-driver:blk_driver — do not edit.'
  echo '#![no_std]'
  printf 'pub static BLK_DRIVER_ELF: [u8; %s] = [' "$$(wc -c < $(location :blk_driver))"
  od -An -v -tu1 $(location :blk_driver) | tr ' ' '\\n' | grep . | paste -sd, -
  echo '];'
} > $@
""",
)

rust_library(
    name = "blk_driver_image",
    srcs = [":blk_driver_image_src"],
    crate_name = "blk_driver_image",
    edition = "2024",
    visibility = ["//kernel/kernel-riscv64:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
