#
# Reading an ELF, for whoever is going to load it. Extracted from
# //userspace/roottask when a second loader needed it — the program Phase 2's
# third bullet runs off a filesystem — and tested here for the first time,
# because a no_main ring-3 binary has no host test target and this is a hundred
# lines of header arithmetic.
# Normative: docs/roadmap/03-composition-and-self-hosting.md ("Phase 2")

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "elfload",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "tessera_elfload",
    edition = "2024",
    version = "0.0.1",
    visibility = ["//userspace:__subpackages__"],
)

# The malformed images. Every one of these was unreachable while the parser
# lived in a binary: a boot check presents a well-formed program and nothing
# else, so the refusals were carried by inspection alone.
rust_test(
    name = "elfload_test",
    crate = ":elfload",
    edition = "2024",
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
