#
# The root task: the first ring-3 ELF program. Built as a real ELF, then
# embedded into the kernel image (v0's "initrd" — a real initrd / Limine module
# is deferred, build/README.md D42) so the kernel loader can parse and map it.
#
# It carries the program it starts, because it has no filesystem to load one
# from — the same compromise the kernel makes about *it*, moved up one level
# (build/README.md, D249). Phase 2 of docs/roadmap/03 replaces that dependency
# with a read from the verified store.
#
# It links against //build/rules:user-x86_64.ld like every other x86-64 user
# program: its own script said the same thing minus `.bss` and `.got`, which is
# the shape of glue that outlives its reason.
# Normative: docs/lifecycle/03-boot-sequence-and-update-mechanics.md

load("//build/rules:embed.bzl", "tessera_embedded_elf")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

# One dep list per architecture. They differ only in which image crates the
# two probes were built for; everything else is the same source and the same
# bindings, which is what the second target exists to demonstrate.
_COMMON_DEPS = [
    "//api/isl:channel_msg_bindings",
    "//api/isl:device_abi_bindings",
    "//api/isl:port_event_bindings",
    "//api/isl:process_abi_bindings",
    "//api/isl-runtime:isl_runtime",
    "//userspace/uabi:uabi",
]

tessera_user_binary(
    name = "roottask",
    srcs = ["src/main.rs"],
    linker_script = "//build/rules:user-x86_64.ld",
    rustc_flags = ["-Copt-level=2"],
    visibility = ["//visibility:public"],
    deps = _COMMON_DEPS + [
        "//userspace/grant-probe:grant_probe_image",
        "//userspace/restart-probe:restart_probe_image",
    ],
)

# The same source, composing the same system, on the port where the driver
# framework runs. The two probe images keep their crate names, so nothing in
# the program is `cfg`-selected but the three per-architecture facts it cannot
# avoid: the ELF machine it loads, and where a child's stack and image go.
tessera_user_binary(
    name = "roottask_aarch64",
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "//build/rules:user-aarch64.ld",
    rustc_flags = ["-Copt-level=2"],
    visibility = ["//visibility:public"],
    deps = _COMMON_DEPS + [
        "//userspace/grant-probe:grant_probe_image_aarch64",
        "//userspace/restart-probe:restart_probe_image_aarch64",
        # The driver framework this port runs: a device manager and a driver
        # that binds by class. The root task composes them, which is the whole
        # of `docs/roadmap/03` Phase 1's second bullet.
        #
        # Their bytes are in this image *and* in the kernel's own component
        # list, because the root task has nowhere to read a program from yet.
        # Phase 2 removes both copies at once (build/README.md, D253).
        "//userspace/device-manager:device_manager_image",
        "//userspace/blk-probe:blk_probe_image",
    ],
)

# The crate keeps the target's name, which is what `//components` expects: its
# generated accessor names the label it was given. Only the *symbol* is
# overridden, so both architectures' images export `ROOT_TASK_ELF` and the
# kernel picks one by `cfg` — the same convention every other per-architecture
# image here follows.
tessera_embedded_elf(
    name = "root_task_image_aarch64",
    binary = ":roottask_aarch64",
    symbol = "ROOT_TASK_ELF",
    visibility = ["//components:__pkg__"],
)

# Embed the built ELF as a Rust byte array (a build output, never committed —
# docs/lifecycle/04, "never check in generated code"). The kernel links this and
# feeds the bytes to its ELF loader.

tessera_embedded_elf(
    name = "root_task_image",
    binary = ":roottask",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
