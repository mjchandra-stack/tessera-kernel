#
# The ring-3 AArch64 power and thermal manager (D140): the service that takes
# power votes and decides what a domain is driven to. Built as an ET_EXEC ELF
# the aarch64 kernel's loader parses and maps, and embedded via the same
# generated-bytes pattern as the device manager; only the Bazel build embeds
# it (the cargo inner loop builds the kernel without it and prints a skip
# line).
#
# The same image is both the manager and a voter, selected by the startup
# argument — a voter is a couple of dozen lines, and a separate crate for that
# would be more build graph than program. What makes the voters real is that
# each runs as its own process with its own endpoint capability.
# Normative: docs/power/01-power-management.md,
# docs/lifecycle/02-build-and-test-infrastructure.md

load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "power_manager",
    srcs = [
        "src/main.rs",
        "src/suspend.rs",
        "src/wake.rs",
    ],
    arch = "aarch64",
    linker_script = "power-manager.aarch64.ld",
    # Optimize: keeps the text segment a handful of pages; the program is
    # embedded byte-for-byte into the kernel image.
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/isl:channel_msg_bindings",
        "//api/isl:device_abi_bindings",
        "//api/isl:driver_lifecycle_bindings",
        "//api/isl:port_event_bindings",
        "//api/isl:power_manager_bindings",
        "//api/isl-runtime:isl_runtime",
        "//api/power:power",
        "//userspace/uabi:uabi",
    ],
)

# The built ELF as Rust bytes (generated at build time, never checked in —
# docs/lifecycle/04, "never check in generated code"). The aarch64 kernel
# links this and feeds the bytes to its ELF loader.
genrule(
    name = "power_manager_image_src",
    srcs = [":power_manager"],
    outs = ["power_manager_image.rs"],
    cmd = """
{
  echo '// SPDX-License-Identifier: Apache-2.0'
  echo '// Copyright 2026 Jagadeesh Chandra Muddana <mjchandra@gmail.com>'
  echo '// Generated from //userspace/power-manager:power_manager — do not edit.'
  echo '#![no_std]'
  printf 'pub static POWER_MANAGER_ELF: [u8; %s] = [' "$$(wc -c < $(location :power_manager))"
  od -An -v -tu1 $(location :power_manager) | tr ' ' '\\n' | grep . | paste -sd, -
  echo '];'
} > $@
""",
)

rust_library(
    name = "power_manager_image",
    srcs = [":power_manager_image_src"],
    crate_name = "power_manager_image",
    edition = "2024",
    visibility = ["//kernel/kernel-aarch64:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
