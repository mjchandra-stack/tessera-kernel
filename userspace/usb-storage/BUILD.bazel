#
# The ring-3 USB mass-storage driver: a no_std Rust user program that serves
# tessera.driver.block off a disk it reaches through two other processes. The
# fourth transport under one class contract — virtio, NVMe and SD each own a
# register window, and this one owns nothing at all, which is the strongest
# available statement that the contract describes a class rather than an
# implementation.
# Normative: docs/drivers/02-storage-networking-usb-pcie.md ("Storage"),
# docs/drivers/01-driver-framework.md

load("//build/rules:embed.bzl", "tessera_embedded_elf")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "usb_storage",
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "//build/rules:user-aarch64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/isl:channel_msg_bindings",
        "//api/isl:device_abi_bindings",
        "//api/isl:driver_bind_bindings",
        "//api/isl:block_driver_abi_bindings",
        "//api/isl:usb_host_bindings",
        "//api/isl-runtime:isl_runtime",
        "//userspace/sdk:sdk",
        "//userspace/uabi:uabi",
    ],
)

# The built ELF as Rust bytes (generated at build time, never checked in —
# docs/lifecycle/04, "never check in generated code").

tessera_embedded_elf(
    name = "usb_storage_image",
    binary = ":usb_storage",
    visibility = ["//kernel/kernel-aarch64:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
