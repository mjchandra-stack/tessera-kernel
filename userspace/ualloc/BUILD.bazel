#
# The heap a ring-3 program allocates from — `docs/roadmap/04` Phase 0, and the
# thing every phase after it needs. Split the way //userspace/elfload is split
# and for the same reason: the algorithm is host-testable and the syscalls are
# not, so the arithmetic lives here with its tests and the mapping lives in the
# `GlobalAlloc` shim beside it.
# Normative: docs/roadmap/04-self-hosting.md ("Phase 0")

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "ualloc",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "tessera_ualloc",
    edition = "2024",
    version = "0.0.1",
    visibility = ["//userspace:__subpackages__"],
)

# Every case is addresses and lengths, so the whole allocator is exercised
# without a machine and without any memory to run against.
rust_test(
    name = "ualloc_test",
    crate = ":ualloc",
    edition = "2024",
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
