#
# The block service: the layer between a filesystem and the storage drivers.
# It speaks the block class contract on both sides, so a consumer cannot tell
# it from a driver and it is held to the same conformance battery.
# Normative: docs/drivers/02-storage-networking-usb-pcie.md

load("//build/rules:embed.bzl", "tessera_embedded_elf")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "block_service",
    # The program store is built from this binary, so //components reads it
    # directly rather than through an embedded-bytes crate (D290).
    visibility = ["//components:__pkg__"],
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "//build/rules:user-aarch64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/isl-runtime:isl_runtime",
        "//api/isl:block_driver_abi_bindings",
        "//userspace/sdk:sdk",
        "//userspace/uabi:uabi",
    ],
)

tessera_embedded_elf(
    name = "block_service_image",
    binary = ":block_service",
    visibility = ["//components:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
