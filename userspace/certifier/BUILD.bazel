#
# The ring-3 certifier: a no_std Rust user program that runs the checks a peer
# can run against a driver — class conformance, and the ABI agreement between
# two independently compiled programs — and then refuses to certify it, because
# nine of the eleven checks need a machine somebody is interfering with from
# outside, a fuzzing engine, or a measurement rig.
#
# The refusal is the deliverable. A runner that certified on two checks would
# hide the failure the whole facility exists to catch: not a driver bug, but a
# rig that stopped asking.
# Normative: docs/drivers/01-driver-framework.md ("Certification")

load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "certifier",
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "certifier.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/certification:certification",
        "//api/class-conformance:class_conformance",
        "//api/power-conformance:power_conformance",
        "//api/isl:channel_msg_bindings",
        "//api/isl:crypto_service_bindings",
        "//api/isl-runtime:isl_runtime",
        "//userspace/uabi:uabi",
    ],
)

# The built ELF as Rust bytes (generated at build time, never checked in —
# docs/lifecycle/04, "never check in generated code").
genrule(
    name = "certifier_image_src",
    srcs = [":certifier"],
    outs = ["certifier_image.rs"],
    cmd = """
{
  echo '// SPDX-License-Identifier: Apache-2.0'
  echo '// Copyright 2026 Jagadeesh Chandra Muddana <mjchandra@gmail.com>'
  echo '// Generated from //userspace/certifier:certifier — do not edit.'
  echo '#![no_std]'
  printf 'pub static CERTIFIER_ELF: [u8; %s] = [' "$$(wc -c < $(location :certifier))"
  od -An -v -tu1 $(location :certifier) | tr ' ' '\\n' | grep . | paste -sd, -
  echo '];'
} > $@
""",
)

rust_library(
    name = "certifier_image",
    srcs = [":certifier_image_src"],
    crate_name = "certifier_image",
    edition = "2024",
    visibility = ["//kernel/kernel-aarch64:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
