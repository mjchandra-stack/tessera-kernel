#
# The ring-3 network class driver: a no_std Rust user program that binds a NIC
# by class and serves tessera.driver.network to a client — the first driver on
# this system that speaks without being asked. Built as an ET_EXEC ELF the
# aarch64 kernel's loader parses and maps, and embedded via the same
# generated-bytes pattern as the other ring-3 programs; only the Bazel build
# embeds it (the cargo inner loop builds the kernel without it and prints a
# skip line).
# Normative: docs/drivers/01-driver-framework.md,
# docs/drivers/02-storage-networking-usb-pcie.md

load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "nvme_driver",
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "nvme-driver.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/isl:block_driver_abi_bindings",
        "//api/isl:channel_msg_bindings",
        "//api/isl:device_abi_bindings",
        "//api/isl:driver_bind_bindings",
        "//api/isl:port_event_bindings",
        "//api/isl-runtime:isl_runtime",
        "//kernel/nvme:nvme",
        "//userspace/uabi:uabi",
    ],
)

# The built ELF as Rust bytes (generated at build time, never checked in —
# docs/lifecycle/04, "never check in generated code").
genrule(
    name = "nvme_driver_image_src",
    srcs = [":nvme_driver"],
    outs = ["nvme_driver_image.rs"],
    cmd = """
{
  echo '// SPDX-License-Identifier: Apache-2.0'
  echo '// Copyright 2026 Jagadeesh Chandra Muddana <mjchandra@gmail.com>'
  echo '// Generated from //userspace/nvme-driver:nvme_driver — do not edit.'
  echo '#![no_std]'
  printf 'pub static NVME_DRIVER_ELF: [u8; %s] = [' "$$(wc -c < $(location :nvme_driver))"
  od -An -v -tu1 $(location :nvme_driver) | tr ' ' '\\n' | grep . | paste -sd, -
  echo '];'
} > $@
""",
)

rust_library(
    name = "nvme_driver_image",
    srcs = [":nvme_driver_image_src"],
    crate_name = "nvme_driver_image",
    edition = "2024",
    visibility = ["//kernel/kernel-aarch64:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
