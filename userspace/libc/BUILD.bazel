#
# The beginning of a C library for this system: how a C program traps to the
# kernel, and what runs before and after its `main`.
#
# **The floor, not the tier.** `docs/roadmap/04` Phase 4 is `docs/api/04`
# tier 1, and this is neither that nor a subset of it chosen in advance — it is
# what the first C program to run here actually needed, which is the rule that
# plan works to: the subset is discovered by running something and seeing what
# it asks for (D306).
# Normative: docs/roadmap/04-self-hosting.md ("Phase 4")

filegroup(
    name = "headers",
    srcs = glob(["include/**/*.h"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "crt0",
    srcs = ["src/crt0.c"],
    visibility = ["//visibility:public"],
)

# The heap, separate from `crt0` because it is separate in kind: `crt0` is what
# every program on this system needs to be a program, and this is what a program
# needs only if it allocates. Both are compiled into every C binary and
# `--gc-sections` drops whichever the program did not reach, so the split is
# about what a reader has to hold at once rather than about image size.
filegroup(
    name = "malloc",
    srcs = ["src/malloc.c"],
    visibility = ["//visibility:public"],
)

# The `<string.h>` subset, which is two functions and a measurement — see the
# header for why not the four a freestanding runtime is usually told to write.
filegroup(
    name = "string",
    srcs = ["src/string.c"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
