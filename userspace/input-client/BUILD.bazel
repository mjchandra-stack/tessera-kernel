#
# The ring-3 input client: blk-client for a different class. It calls every
# required method of tessera.driver.input, one optional the driver advertises
# and one it does not, a reset and a vendor ordinal, and hands the transcript to
# the same conformance suite that judges the block, network and clock contracts
# — which knows what an ordinal is and does not know what a keyboard is.
# Normative: docs/drivers/01-driver-framework.md

load("//build/rules:embed.bzl", "tessera_embedded_elf")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "input_client",
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "//build/rules:user-aarch64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//api/class-conformance:class_conformance",
        "//api/isl:channel_msg_bindings",
        "//api/isl:input_device_bindings",
        "//api/isl-runtime:isl_runtime",
        "//userspace/uabi:uabi",
    ],
)

# The built ELF as Rust bytes (generated at build time, never checked in —
# docs/lifecycle/04, "never check in generated code").

tessera_embedded_elf(
    name = "input_client_image",
    binary = ":input_client",
    visibility = ["//components:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
