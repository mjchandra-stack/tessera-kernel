#
# The ring-3 block-service client (D81): a no_std Rust user program holding
# only a channel endpoint — no device or DMA capability — that requests a
# sector read from the ring-3 blk driver and verifies the returned bytes.
# Built and embedded exactly like the driver (Bazel-only; the cargo inner
# loop builds the kernel without it and prints a skip line).
# Normative: docs/lifecycle/02-build-and-test-infrastructure.md

load("//build/rules:embed.bzl", "tessera_embedded_elf")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

tessera_user_binary(
    name = "blk_client",
    # The program store is built from this binary, so //components reads it
    # directly rather than through an embedded-bytes crate (D290).
    visibility = ["//components:__pkg__"],
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "//build/rules:user-aarch64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//userspace/uabi:uabi",
        "//api/class-conformance:class_conformance",
        "//api/isl:block_driver_abi_bindings",
        "//api/isl:channel_msg_bindings",
        "//api/isl:firmware_bindings",
        "//api/isl:memory_abi_bindings",
        "//api/isl-runtime:isl_runtime",
    ],
)

# The same source on the second machine, and the reason it is worth a target:
# this program carries the block class's conformance battery, so porting it is
# what runs that battery against a second machine's driver stack (D323).
tessera_user_binary(
    name = "blk_client_x86_64",
    # The program store is built from this binary, so //components reads it
    # directly rather than through an embedded-bytes crate (D290).
    visibility = ["//components:__pkg__"],
    srcs = ["src/main.rs"],
    arch = "x86_64",
    linker_script = "//build/rules:user-x86_64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = [
        "//userspace/uabi:uabi",
        "//api/class-conformance:class_conformance",
        "//api/isl:block_driver_abi_bindings",
        "//api/isl:channel_msg_bindings",
        "//api/isl:firmware_bindings",
        "//api/isl:memory_abi_bindings",
        "//api/isl-runtime:isl_runtime",
    ],
)

# The built ELF as Rust bytes (generated at build time, never checked in).

tessera_embedded_elf(
    name = "blk_client_image",
    binary = ":blk_client",
    visibility = ["//components:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
