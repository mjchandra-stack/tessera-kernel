#
# The log service: what a program's output is addressed to. It holds one
# endpoint speaking diagnostic.isl, and forwards every record whole to whoever
# composed the run — because no port implements DebugWrite's declared buffer
# form, so there is no console in this system a ring-3 program can render text
# to. When one arrives, this is the one program that changes.
#
# Built for all five architectures over one source, like the probes beside it.
# Normative: docs/roadmap/04-self-hosting.md ("Phase 1")

load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:embed.bzl", "tessera_embedded_elf")
load("//build/rules:userspace.bzl", "tessera_user_binary")

# One dep list, so the five architectures cannot drift apart.
DEPS = [
    "//api/isl:channel_msg_bindings",
    "//api/isl:diagnostic_bindings",
    "//api/isl:process_abi_bindings",
    "//api/isl-runtime:isl_runtime",
    "//userspace/uabi:uabi",
]

tessera_user_binary(
    name = "log_service",
    srcs = ["src/main.rs"],
    linker_script = "//build/rules:user-x86_64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

# The built ELF as Rust bytes, linked into the root task. The image crate keeps
# its unsuffixed name on every architecture, so the root task `use`s one name
# and the build picks which.
tessera_embedded_elf(
    name = "log_service_image",
    binary = ":log_service",
    visibility = ["//userspace/roottask:__pkg__"],
)

tessera_user_binary(
    name = "log_service_aarch64",
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "//build/rules:user-aarch64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

tessera_embedded_elf(
    name = "log_service_image_aarch64",
    binary = ":log_service_aarch64",
    crate = "log_service_image",
    symbol = "LOG_SERVICE_ELF",
    visibility = ["//userspace/roottask:__pkg__"],
)

tessera_user_binary(
    name = "log_service_riscv64",
    srcs = ["src/main.rs"],
    arch = "riscv64",
    linker_script = "//build/rules:user-riscv64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

tessera_embedded_elf(
    name = "log_service_image_riscv64",
    binary = ":log_service_riscv64",
    crate = "log_service_image",
    symbol = "LOG_SERVICE_ELF",
    visibility = ["//userspace/roottask:__pkg__"],
)

# The 32-bit machines. `StartupArgs` is 592 bytes wherever it is built — the
# whole point of a schema over a remembered layout — but the startup *word*
# carrying its address is 32 bits here (D259), which is the constraint that
# made the startup message necessary in the first place.
tessera_user_binary(
    name = "log_service_riscv32",
    srcs = ["src/main.rs"],
    arch = "riscv32",
    linker_script = "//build/rules:user-riscv32.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

tessera_embedded_elf(
    name = "log_service_image_riscv32",
    binary = ":log_service_riscv32",
    crate = "log_service_image",
    symbol = "LOG_SERVICE_ELF",
    visibility = ["//userspace/roottask:__pkg__"],
)

tessera_user_binary(
    name = "log_service_arm32",
    srcs = ["src/main.rs"],
    arch = "arm32",
    linker_script = "//build/rules:user-arm32.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

tessera_embedded_elf(
    name = "log_service_image_arm32",
    binary = ":log_service_arm32",
    crate = "log_service_image",
    symbol = "LOG_SERVICE_ELF",
    visibility = ["//userspace/roottask:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
