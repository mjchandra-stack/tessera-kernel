#
# The first program on this machine that is not written in Rust: C, compiled by
# the host toolchain, with an `int main(void)` that returns — and syscall
# numbers that come from the published ABI headers rather than from constants
# in its own source (docs/roadmap/04 Phase 4; D306).
# Normative: docs/roadmap/04-self-hosting.md ("Phase 4")

load("//build/rules:cprogram.bzl", "tessera_c_binary")
load("//build/rules:embed.bzl", "tessera_embedded_elf")

tessera_c_binary(
    name = "c_probe",
    srcs = ["src/main.c"],
    visibility = ["//components:__pkg__"],
)

tessera_embedded_elf(
    name = "c_probe_image",
    binary = ":c_probe",
    visibility = ["//components:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
