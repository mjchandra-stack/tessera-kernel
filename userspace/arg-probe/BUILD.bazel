#
# The argument probe: the first ring-3 program in this tree told what to work
# on rather than compiled knowing it. //userspace/roottask grants it an
# endpoint, puts a path in `StartupArgs` on its startup message, and starts it;
# it sends those exact bytes back and exits with an `ExitStatus`.
#
# Built for all five architectures over one source, like //userspace/grant-probe
# and for the same reason: the startup message is `kcore`'s mechanism and the
# root task that sends one is the same program on every machine, so a shape that
# worked on one port and not another would be a finding rather than a surprise.
# Normative: docs/roadmap/04-self-hosting.md ("Phase 1")

load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:embed.bzl", "tessera_embedded_elf")
load("//build/rules:userspace.bzl", "tessera_user_binary")

# One dep list, so the five architectures cannot drift apart.
DEPS = [
    "//api/isl:channel_msg_bindings",
    "//api/isl:process_abi_bindings",
    "//api/isl-runtime:isl_runtime",
    "//userspace/uabi:uabi",
]

tessera_user_binary(
    name = "arg_probe",
    srcs = ["src/main.rs"],
    linker_script = "//build/rules:user-x86_64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

# The built ELF as Rust bytes, linked into the root task. The image crate keeps
# its unsuffixed name on every architecture, so the root task `use`s one name
# and the build picks which.
tessera_embedded_elf(
    name = "arg_probe_image",
    binary = ":arg_probe",
    visibility = ["//userspace/roottask:__pkg__"],
)

tessera_user_binary(
    name = "arg_probe_aarch64",
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "//build/rules:user-aarch64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

tessera_embedded_elf(
    name = "arg_probe_image_aarch64",
    binary = ":arg_probe_aarch64",
    crate = "arg_probe_image",
    symbol = "ARG_PROBE_ELF",
    visibility = ["//userspace/roottask:__pkg__"],
)

tessera_user_binary(
    name = "arg_probe_riscv64",
    srcs = ["src/main.rs"],
    arch = "riscv64",
    linker_script = "//build/rules:user-riscv64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

tessera_embedded_elf(
    name = "arg_probe_image_riscv64",
    binary = ":arg_probe_riscv64",
    crate = "arg_probe_image",
    symbol = "ARG_PROBE_ELF",
    visibility = ["//userspace/roottask:__pkg__"],
)

# The 32-bit machines. `StartupArgs` is 592 bytes wherever it is built — the
# whole point of a schema over a remembered layout — but the startup *word*
# carrying its address is 32 bits here (D259), which is the constraint that
# made the startup message necessary in the first place.
tessera_user_binary(
    name = "arg_probe_riscv32",
    srcs = ["src/main.rs"],
    arch = "riscv32",
    linker_script = "//build/rules:user-riscv32.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

tessera_embedded_elf(
    name = "arg_probe_image_riscv32",
    binary = ":arg_probe_riscv32",
    crate = "arg_probe_image",
    symbol = "ARG_PROBE_ELF",
    visibility = ["//userspace/roottask:__pkg__"],
)

tessera_user_binary(
    name = "arg_probe_arm32",
    srcs = ["src/main.rs"],
    arch = "arm32",
    linker_script = "//build/rules:user-arm32.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

tessera_embedded_elf(
    name = "arg_probe_image_arm32",
    binary = ":arg_probe_arm32",
    crate = "arg_probe_image",
    symbol = "ARG_PROBE_ELF",
    visibility = ["//userspace/roottask:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
