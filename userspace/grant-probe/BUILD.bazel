#
# The grant probe: the first ring-3 program in this tree whose handle table the
# kernel did not fill in. //userspace/roottask loads it, grants it one channel
# endpoint with ProcessGrant, and starts it; it sends one message on that
# endpoint and exits.
#
# Its ELF is embedded into the *root task* rather than into the kernel, because
# the root task is what loads it — which is also what makes Phase 2 a change of
# one line here rather than a change of mechanism (docs/roadmap/03).
# Normative: docs/lifecycle/02-build-and-test-infrastructure.md

load("//build/rules:embed.bzl", "tessera_embedded_elf")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build/rules:userspace.bzl", "tessera_user_binary")

# One dep list, so the two architectures cannot drift apart.
DEPS = [
    "//api/isl:channel_msg_bindings",
    "//api/isl:process_abi_bindings",
    "//api/isl-runtime:isl_runtime",
    "//userspace/uabi:uabi",
]

tessera_user_binary(
    name = "grant_probe",
    srcs = ["src/main.rs"],
    linker_script = "//build/rules:user-x86_64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

# The built ELF as Rust bytes, linked into the root task.

tessera_embedded_elf(
    name = "grant_probe_image",
    binary = ":grant_probe",
    visibility = ["//userspace/roottask:__pkg__"],
)

# The same source, built for the second architecture. The root task's claim is
# that composing a system is common to every port; two targets over one source
# is what makes that checkable rather than asserted. The image crate keeps its
# unsuffixed name, so the root task `use`s one name and the build picks which.
tessera_user_binary(
    name = "grant_probe_aarch64",
    srcs = ["src/main.rs"],
    arch = "aarch64",
    linker_script = "//build/rules:user-aarch64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

tessera_embedded_elf(
    name = "grant_probe_image_aarch64",
    binary = ":grant_probe_aarch64",
    crate = "grant_probe_image",
    symbol = "GRANT_PROBE_ELF",
    visibility = ["//userspace/roottask:__pkg__"],
)

# And the third architecture. Same source again; what differs is the linker
# script's output format and load address, which is the whole of what a port
# costs a user program.
tessera_user_binary(
    name = "grant_probe_riscv64",
    srcs = ["src/main.rs"],
    arch = "riscv64",
    linker_script = "//build/rules:user-riscv64.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

tessera_embedded_elf(
    name = "grant_probe_image_riscv64",
    binary = ":grant_probe_riscv64",
    crate = "grant_probe_image",
    symbol = "GRANT_PROBE_ELF",
    visibility = ["//userspace/roottask:__pkg__"],
)

# And the fourth: the first 32-bit machine to run a root task (D262).
tessera_user_binary(
    name = "grant_probe_riscv32",
    srcs = ["src/main.rs"],
    arch = "riscv32",
    linker_script = "//build/rules:user-riscv32.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

tessera_embedded_elf(
    name = "grant_probe_image_riscv32",
    binary = ":grant_probe_riscv32",
    crate = "grant_probe_image",
    symbol = "GRANT_PROBE_ELF",
    visibility = ["//userspace/roottask:__pkg__"],
)

# And the fifth, which completes the matrix (D263).
tessera_user_binary(
    name = "grant_probe_arm32",
    srcs = ["src/main.rs"],
    arch = "arm32",
    linker_script = "//build/rules:user-arm32.ld",
    rustc_flags = ["-Copt-level=2"],
    deps = DEPS,
)

tessera_embedded_elf(
    name = "grant_probe_image_arm32",
    binary = ":grant_probe_arm32",
    crate = "grant_probe_image",
    symbol = "GRANT_PROBE_ELF",
    visibility = ["//userspace/roottask:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
