#
# The ISL compiler: a host build tool. The library is the compiler; `islc` is
# the CLI used by codegen genrules. Generated bindings are build outputs, never
# committed (docs/lifecycle/04-coding-guidelines.md, "Never edit or check in
# generated code").
# Normative: docs/api/03-interface-schema-language.md,
# docs/lifecycle/02-build-and-test-infrastructure.md

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)

rust_library(
    name = "isl",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    # Example schemas are `include_str!`d by codegen determinism tests.
    compile_data = glob(["examples/**/*.isl"]),
    crate_name = "tessera_isl",
    edition = "2024",
    version = "0.0.1",
    visibility = ["//tools/lint:__pkg__"],
)

rust_binary(
    name = "islc",
    srcs = ["src/bin/islc.rs"],
    edition = "2024",
    version = "0.0.1",
    visibility = ["//visibility:public"],
    deps = [":isl"],
)

# Unit tests of the compiler internals (lexer, parser, checker, codegen).
rust_test(
    name = "isl_unit_test",
    crate = ":isl",
    edition = "2024",
)

_EXAMPLES = [
    "examples/syscall_handle_ops.isl",
    "examples/echo_service.isl",
    "examples/handle_abi.isl",
    "examples/channel_msg.isl",
    "examples/syscall_abi.isl",
    "examples/bench_result.isl",
    "examples/process_abi.isl",
    "examples/device_abi.isl",
    "examples/block_driver.isl",
    "examples/driver_bind.isl",
    "examples/port_event.isl",
    "examples/kernel_event.isl",
    "examples/demo_verdict.isl",
    "examples/union_variant.isl",
    "examples/table_record.isl",
    "examples/collections.isl",
    "examples/rpc.isl",
    "examples/invalid/ordinal_reuse.isl",
]

# Tier-0 gate: example schemas check clean and emit deterministically; the
# negative fixture is rejected.
sh_test(
    name = "schema_gate_test",
    srcs = ["isl_gate.sh"],
    args = ["$(location :islc)"] + ["$(location %s)" % e for e in _EXAMPLES],
    data = [":islc"] + _EXAMPLES,
)

# Codegen as a build rule: the compiler generates Rust bindings at build time;
# the output is never committed (docs/lifecycle/04, "never check in generated
# code"). The genrule output feeds a rust_library that the conformance test
# links.
genrule(
    name = "handleops_generated",
    srcs = ["examples/syscall_handle_ops.isl"],
    outs = ["handleops_generated.rs"],
    cmd = "$(location :islc) emit-rust $(location examples/syscall_handle_ops.isl) > $@",
    tools = [":islc"],
)

rust_library(
    name = "handleops_bindings",
    srcs = [":handleops_generated"],
    crate_name = "handleops",
    edition = "2024",
    deps = ["//api/isl-runtime:isl_runtime"],
)

# Tier-2 conformance: the generated bindings compile and round-trip the golden
# byte vectors, and reject non-canonical input.
rust_test(
    name = "conformance_test",
    srcs = ["tests/conformance.rs"],
    edition = "2024",
    deps = [
        ":handleops_bindings",
        "//api/isl-runtime:isl_runtime",
    ],
)

# The handle syscall ABI, generated and conformance-checked the same way.
genrule(
    name = "handle_abi_generated",
    srcs = ["examples/handle_abi.isl"],
    outs = ["handle_abi_generated.rs"],
    cmd = "$(location :islc) emit-rust $(location examples/handle_abi.isl) > $@",
    tools = [":islc"],
)

rust_library(
    name = "handle_abi_bindings",
    srcs = [":handle_abi_generated"],
    crate_name = "handle_abi",
    edition = "2024",
    # The kernel core consumes these bindings for its syscall ABI (D24).
    visibility = ["//kernel/kcore:__pkg__"],
    deps = ["//api/isl-runtime:isl_runtime"],
)

rust_test(
    name = "handle_abi_conformance_test",
    srcs = ["tests/handle_abi_conformance.rs"],
    edition = "2024",
    deps = [
        ":handle_abi_bindings",
        "//api/isl-runtime:isl_runtime",
    ],
)

