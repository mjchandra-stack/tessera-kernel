#
# SHA-256, once (retires D13). It was written twice before — once for interface
# ids and once for the dependency allowlist — and both copies were `Vec`-based
# and host-only. `no_std` and allocation-free, so the same code the build tools
# use is the code that measures an image at boot.
# Normative: docs/security/02-cryptography-and-key-management.md
# ("Crypto Agility")

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "hash",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "tessera_hash",
    edition = "2024",
    version = "0.0.1",
    visibility = ["//visibility:public"],
)

# Tier-1: the FIPS vectors, the padding boundaries, and streaming agreeing with
# the one-shot at every split — the last of which is what an incremental hash
# has to be held to and the deleted copies never were.
rust_test(
    name = "hash_test",
    crate = ":hash",
    edition = "2024",
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
