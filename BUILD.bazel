#
# Repository root package: shared lint configuration and source filegroups
# consumed by the tier-0 checks.
# Normative: docs/lifecycle/02-build-and-test-infrastructure.md

exports_files([
    "rustfmt.toml",
    "clippy.toml",
    "unsafe-inventory.toml",
])

# Files owned by the root package (docs/, configs, manifests). Bazel globs
# stop at subpackage boundaries, so subpackages contribute their own :srcs.
filegroup(
    name = "root_srcs",
    srcs = glob(
        ["**"],
        exclude = [
            ".claude/**",  # session/tooling state, not project source
            ".git/**",
            "bazel-*",
            "bazel-*/**",
            "target/**",  # cargo inner-loop outputs
        ],
        allow_empty = False,
    ),
)

# Everything the tier-0 gates inspect. New packages must be added here —
# the gates fail loudly if the tree looks empty, never silently shrink.
filegroup(
    name = "all_srcs",
    srcs = [
        ":root_srcs",
        "//api/binding:srcs",
