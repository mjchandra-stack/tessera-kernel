#
# Tier-0 formatting and lint gates.
#
# `rustfmt_test` is the part that runs under a plain `bazel test //...`, and it
# covers the six crates listed below and nothing else. Wider coverage comes
# from the aspects: `bazel build //... --config=lint` reaches everything the
# host platform can configure, and `--config=lint-<arch>` reaches the ports and
# kernel binaries, which no single invocation can (see .bazelrc, deviation
# D183).
#
# So this list is a convenience target, not the coverage mechanism. Adding a
# crate here buys only that `bazel test` also checks it.
# Normative: docs/lifecycle/02-build-and-test-infrastructure.md ("Tier 0")

load("@rules_rust//rust:defs.bzl", "rust_clippy", "rustfmt_test")

# Host-configurable crates only: a target restricted to os:none is *skipped*
# on a host build rather than failing, so listing one here would be silent
# non-coverage. Those are reached by `--config=lint-<arch>` instead.
_LINT_TARGETS = [
    "//api/isl:isl",
    "//api/isl-runtime:isl_runtime",
    "//kernel/karch",
    "//kernel/karch-mock",
    "//kernel/kcore",
    "//tools/checks",
]

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)

rustfmt_test(
    name = "rustfmt",
    targets = _LINT_TARGETS,
)

# Buildable clippy target for direct runs: bazel build //tools/lint:clippy
rust_clippy(
    name = "clippy",
    testonly = True,
    deps = _LINT_TARGETS,
)
