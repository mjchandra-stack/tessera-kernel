#
# Tier-0 static gates. Each gate is an ordinary test target so
# `bazel test //...` runs the whole tier; the checked sources arrive as
# runfiles via //:all_srcs.
# Normative: docs/lifecycle/02-build-and-test-infrastructure.md ("Tier 0")

load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)

rust_library(
    name = "checks",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "tessera_checks",
    edition = "2024",
    visibility = ["//tools/lint:__pkg__"],
    deps = [
        "//api/hash",
        "//api/isl",
        "//tools/kconfig:kconfig_lib",
    ],
)

# Unit tests of the gate logic itself (sha256 vectors, scanner cases).
rust_test(
    name = "checks_unit_test",
    crate = ":checks",
    edition = "2024",
)

# The 32-bit ring-3 toolchain against the loader that has to accept its output.
#
# Its own rule rather than a member of the list below: the others read the
# source tree, and this one reads a *built artifact* — which is the point, since
# what it checks is an agreement between the build rules and the kernel that
# neither package can hold alone.
rust_test(
    name = "user_elf32_test",
    srcs = ["tests/user_elf32.rs"],
    data = ["//userspace/restart-probe:restart_probe_riscv32"],
    edition = "2024",
    env = {
        "TESSERA_RISCV32_PROGRAM": "$(rootpath //userspace/restart-probe:restart_probe_riscv32)",
    },
    deps = ["//kernel/kcore"],
)

[
    rust_test(
        name = name + "_test",
        srcs = ["tests/" + name + ".rs"],
        data = ["//:all_srcs"],
        edition = "2024",
        deps = [
            ":checks",
            "//tools/kconfig:kconfig_lib",
        ],
    )
    for name in [
        "spdx",
        "license",
        "unsafe_inventory",
        "fuzz_gate",
        "packages",
        "boundary",
        "flags",
        "logging",
        "doubles",
        "config",
        "ledger",
        "surface",
    ]
]
