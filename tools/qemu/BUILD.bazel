tessera_boot_check(
    name = "pcie_boot_riscv64",
    inputs = [
        "//kernel/kernel-riscv64:kernel-riscv64",
        ":virtio_test_disk",
    ],
)

tessera_boot_check(
    name = "power_boot_aarch64",
    inputs = ["//kernel/kernel-aarch64:kernel-aarch64_image"],
)

tessera_boot_check(
    name = "ring3_host_boot_aarch64",
    inputs = [
        "//kernel/kernel-aarch64:kernel-aarch64_image",
        ":virtio_test_disk",
    ],
)

tessera_boot_check(
    name = "sd_boot_aarch64",
    inputs = [
