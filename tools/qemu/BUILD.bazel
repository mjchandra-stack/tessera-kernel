# The only test here that acts on the machine while it runs: it waits for the
# kernel to say it is holding the device, then removes the device over QMP.
# Removal is not a state a machine can be booted into.
sh_test(
    name = "hotplug_boot_aarch64_test",
    srcs = ["hotplug_boot_aarch64.sh"],
    args = [
        "$(location //kernel/kernel-aarch64:kernel-aarch64_image)",
        "$(location :virtio_test_disk)",
    ],
    data = [
        ":virtio_test_disk",
        "//kernel/kernel-aarch64:kernel-aarch64_image",
    ],
    tags = [
        "no-remote",
        # `socat` drives the QMP socket, on top of the usual QEMU requirement.
        "requires-qemu",
    ],
    timeout = "moderate",
)

