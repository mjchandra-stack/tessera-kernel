# The same kernel, configured by a second profile — the machine that makes
# `config/kernel.config` a surface somebody has used rather than one the tool
# would allow (D195's exit criterion).
profile_binary(
    name = "kernel-aarch64_lean_image",
    binary = "//kernel/kernel-aarch64:kernel-aarch64_image",
    profile = "aarch64-lean",
)

tessera_boot_check(
    name = "profile_boot_aarch64",
    inputs = [
        ":kernel-aarch64_lean_image",
        "//kernel/kernel-aarch64:kernel-aarch64_image",
    ],
    timeout = "long",
)

tessera_boot_check(
    name = "certification_boot_aarch64",
    inputs = [
        "//kernel/kernel-aarch64:kernel-aarch64_image",
        "//tools/certify:certify",
    ],
    timeout = "long",
)

tessera_boot_check(
    name = "crypto_boot_aarch64",
    inputs = ["//kernel/kernel-aarch64:kernel-aarch64_image"],
    timeout = "long",
)

tessera_boot_check(
    name = "fs_boot_aarch64",
    inputs = [
        "//kernel/kernel-aarch64:kernel-aarch64_image",
        ":virtio_test_disk",
        ":ext2_test_disk",
    ],
)

# **The gate** (docs/roadmap/04 Phase 6). Two boots of one volume rather than
# one, which is why it is a check of its own and not a leg of the one above:
# `fs_boot_aarch64` is a single machine on a pristine copy, and what this asks
# is what survives the machine going away.
tessera_boot_check(
    name = "self_host_aarch64",
    inputs = [
        "//kernel/kernel-aarch64:kernel-aarch64_image",
        ":virtio_test_disk",
        ":ext2_test_disk",
    ],
    timeout = "long",
)

