#
# Tier-3 smoke boot. QEMU comes from the host for this milestone
# (deviation D4, build/README.md), so the test is tagged for local
# execution only.
# Normative: docs/lifecycle/02-build-and-test-infrastructure.md ("Tier 3")

load("//build/rules:qemu.bzl", "tessera_boot_check")

tessera_boot_check(
    name = "certification_boot_aarch64",
    inputs = [
        "//kernel/kernel-aarch64:kernel-aarch64_image",
        "//tools/certify:certify",
    ],
    timeout = "long",
)

tessera_boot_check(
    name = "crypto_boot_aarch64",
    inputs = ["//kernel/kernel-aarch64:kernel-aarch64_image"],
    timeout = "long",
)

tessera_boot_check(
    name = "gpio_boot_aarch64",
    inputs = ["//kernel/kernel-aarch64:kernel-aarch64_image"],
    timeout = "long",
)

tessera_boot_check(
    name = "gpu_boot_aarch64",
    inputs = ["//kernel/kernel-aarch64:kernel-aarch64_image"],
    timeout = "long",
)

tessera_boot_check(
    name = "hotplug_boot_aarch64",
    inputs = [
        "//kernel/kernel-aarch64:kernel-aarch64_image",
        ":virtio_test_disk",
    ],
)

tessera_boot_check(
    name = "msi_boot_aarch64",
    inputs = ["//kernel/kernel-aarch64:kernel-aarch64_image"],
)

tessera_boot_check(
