# Tier-3 smoke boot. QEMU comes from the host for this milestone
# (deviation D4, build/README.md), so the test is tagged for local
# execution only.
# Normative: docs/lifecycle/02-build-and-test-infrastructure.md ("Tier 3")

sh_test(
    name = "smoke_boot_test",
    srcs = ["smoke_boot.sh"],
    args = [
        "$(location //kernel/image:tessera_iso)",
        "$(location :virtio_test_disk)",
    ],
    data = [
        "//kernel/image:tessera_iso",
        ":virtio_test_disk",
    ],
    tags = [
        "no-remote",
        "requires-qemu",
    ],
    timeout = "moderate",
)

