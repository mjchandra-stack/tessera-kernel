)

tessera_boot_check(
    name = "smoke_boot_aarch64",
    inputs = ["//kernel/kernel-aarch64:kernel-aarch64_image"],
)

tessera_boot_check(
    name = "smoke_boot_arm32",
    inputs = ["//kernel/kernel-arm32:kernel-arm32_image"],
