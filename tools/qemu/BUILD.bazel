# A deterministic virtio-blk backing disk: sector 0 begins with the magic the
# driver verifies, padded to 1 MiB (a whole number of 512-byte sectors).
genrule(
    name = "virtio_test_disk",
    outs = ["virtio_test_disk.img"],
    # Sector 0 carries TESSERAV (every existing check), sector 1 carries
    # TESSERA2 so a second-sector read is verifiable rather than vacuously
    # zeros (the resident driver host reads both, D82).
    cmd = "printf 'TESSERAV' > $@ && truncate -s 512 $@ && printf 'TESSERA2' >> $@ && truncate -s 1048576 $@",
)

