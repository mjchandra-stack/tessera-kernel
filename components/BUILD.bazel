#
# What each machine image is composed of: the ring-3 programs its kernel
# carries, because a kernel with no filesystem has nowhere else to load them
# from.
#
# The list is here rather than in each port's BUILD file because it is
# composition and not kernel. A kernel package naming //userspace/gpu-driver
# points the dependency the wrong way — the kernel is what userspace is built
# against, and it should not know which drivers a particular image happens to
# ship. It names one label from here instead.
#
# Not `docs/architecture/01`'s component manifest, which is a runtime object
# carrying capabilities, restart policy and budgets. This is the build-time
# composition alone.
# Normative: docs/architecture/01-system-architecture.md ("Component Model"),
# docs/lifecycle/02-build-and-test-infrastructure.md

load("@rules_rust//rust:defs.bzl", "rust_test")
load("//build/rules:components.bzl", "tessera_image_components")

package(default_visibility = ["//visibility:private"])

# The AArch64 machine: the driver framework end to end — a device manager, a
# resident driver host, a driver and a client for each of eight device classes,
# a power manager and a certifier.
tessera_image_components(
    name = "aarch64",
    components = {
        "blk_client": "//userspace/blk-client:blk_client",
        "block_service": "//userspace/block-service:block_service",
        "blk_probe": "//userspace/blk-probe:blk_probe",
        "certifier": "//userspace/certifier:certifier",
        "crypto_client": "//userspace/crypto-client:crypto_client",
        "crypto_driver": "//userspace/crypto-driver:crypto_driver",
        "device_host": "//userspace/device-host:device_host",
        "device_manager": "//userspace/device-manager:device_manager",
        "fs_client": "//userspace/fs-client:fs_client",
        "fs_service": "//userspace/fs-service:fs_service",
        "gpio_client": "//userspace/gpio-client:gpio_client",
        "gpio_driver": "//userspace/gpio-driver:gpio_driver",
        "gpu_client": "//userspace/gpu-client:gpu_client",
        "gpu_driver": "//userspace/gpu-driver:gpu_driver",
        "input_client": "//userspace/input-client:input_client",
        "net_client": "//userspace/net-client:net_client",
        "net_driver": "//userspace/net-driver:net_driver",
        "net_stack": "//userspace/net-stack:net_stack",
        "flow_client": "//userspace/flow-client:flow_client",
        "nvme_driver": "//userspace/nvme-driver:nvme_driver",
        "pci_bus": "//userspace/pci-bus:pci_bus",
        "platform_bus": "//userspace/platform-bus:platform_bus",
        "power_manager": "//userspace/power-manager:power_manager",
        "root_task": "//userspace/roottask:roottask_aarch64",
        "sd_host": "//userspace/sd-host:sd_host",
        "snd_client": "//userspace/snd-client:snd_client",
        "snd_driver": "//userspace/snd-driver:snd_driver",
        "usb_hid": "//userspace/usb-hid:usb_hid",
        "usb_host": "//userspace/usb-host:usb_host",
        "usb_storage": "//userspace/usb-storage:usb_storage",
    },
    visibility = ["//kernel/kernel-aarch64:__pkg__"],
)

# The ARM 32 machine, which completes the matrix: every port here runs the same
# root task now, from the same source (build/README.md, D263).
tessera_image_components(
    name = "arm32",
    components = {
        "root_task": "//userspace/roottask:roottask_arm32",
    },
    visibility = ["//kernel/kernel-arm32:__pkg__"],
)

# The RISC-V 32 machine: a root task, and the programs it starts are linked
# into it rather than carried here (build/README.md, D262). One line, because
# this image carries no driver framework — the manager and the driver are not
# built for this target yet, and the root task composes what it can.
tessera_image_components(
    name = "riscv32",
    components = {
        "root_task": "//userspace/roottask:roottask_riscv32",
    },
    visibility = ["//kernel/kernel-riscv32:__pkg__"],
)

# The RISC-V 64 machine: a compiled ring-3 block driver, bound by a device
# manager, with the probe that reads the disk through it.
tessera_image_components(
    name = "riscv64",
    components = {
        "blk_driver": "//userspace/blk-driver:blk_driver",
        "blk_probe": "//userspace/blk-probe:blk_probe_riscv64",
        "device_manager": "//userspace/device-manager:device_manager_riscv64",
        "root_task": "//userspace/roottask:roottask_riscv64",
    },
    visibility = ["//kernel/kernel-riscv64:__pkg__"],
)

# The x86-64 machine: a root task, and PCIe discovery bound from ring 3.
tessera_image_components(
    name = "x86_64",
    components = {
        "blk_probe": "//userspace/blk-probe:blk_probe_x86_64",
        "device_manager": "//userspace/device-manager:device_manager_x86_64",
        "pci_bus": "//userspace/pci-bus:pci_bus_x86_64",
        "root_task": "//userspace/roottask:roottask",
    },
    visibility = ["//kernel/kernel:__pkg__"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)

# **The gate that keeps the signing key and the kernel's anchor in step.**
#
# `kcore::store::TRUSTED_ANCHORS` holds the *public* half of the key
# `build/rules/components.bzl` signs with. Nothing derives one from the other —
# deliberately, for the reason the system store's measurement is pasted rather
# than generated — so a seed changed without the anchor being updated would
# produce a kernel that refuses every program it carries, and the only symptom
# would be a boot with nothing started. This fails first, in `bazel test`, and
# prints what to paste.
rust_test(
    name = "program_anchor_test",
    srcs = ["tests/program_anchor.rs"],
    data = [":aarch64_programs.bin"],
    edition = "2024",
    deps = [
        "//api/image-store:image_store",
        "//kernel/kcore",
    ],
)
