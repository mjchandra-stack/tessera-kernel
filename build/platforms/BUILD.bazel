#
# Target platforms. Kernel code builds for a bare (os:none) platform per
# architecture. Each supported CPU family gets one; `build/rules/kernel.bzl`
# maps an architecture name onto the matching platform and codegen flags.
# Normative: docs/lifecycle/02-build-and-test-infrastructure.md,
# docs/hardware/01-platform-and-cpu-support.md ("Porting Rules")

platform(
    name = "x86_64-kernel",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "aarch64-kernel",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:none",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "riscv64-kernel",
    constraint_values = [
        "@platforms//cpu:riscv64",
        "@platforms//os:none",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "arm32-kernel",
    constraint_values = [
        "@platforms//cpu:armv7",
        "@platforms//os:none",
    ],
    visibility = ["//visibility:public"],
)

# A 32-bit platform. No port targets it yet — it exists so the
# architecture-independent crates can be *compiled* for a 32-bit word size,
# which is what keeps them word-size-generic before either 32-bit port lands
# (docs/hardware/01-platform-and-cpu-support.md, "Endianness And Word Size").
platform(
    name = "riscv32-kernel",
    constraint_values = [
        "@platforms//cpu:riscv32",
        "@platforms//os:none",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
