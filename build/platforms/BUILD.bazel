#
# Target platforms. Kernel code builds for a bare (os:none) platform per
# architecture. Each supported CPU family gets one; `build/rules/kernel.bzl`
# maps an architecture name onto the matching platform and codegen flags.
# Normative: docs/lifecycle/02-build-and-test-infrastructure.md,
# docs/hardware/01-platform-and-cpu-support.md ("Porting Rules")

platform(
    name = "x86_64-kernel",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
    ],
    visibility = ["//visibility:public"],
)

platform(
    name = "aarch64-kernel",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:none",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "srcs",
    srcs = glob(["**"]),
    visibility = ["//:__pkg__"],
)
